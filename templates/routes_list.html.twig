{% extends 'base.html.twig' %}

{% block title %}Liste des Routes et Maintenance{% endblock %}

{% macro roles_dropdown(availableRoles, selectedRoles, category) %}
    <div class="dropdown roles-dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle text-nowrap" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
            <i class="fas fa-user-shield"></i>
            <span class="roles-dropdown-label">
                {% if selectedRoles is empty %}Accès autorisé : aucun rôle{% else %}Accès autorisé : {{ selectedRoles|length }} rôle(s){% endif %}
            </span>
        </button>
        <div class="dropdown-menu p-2" style="max-height: 300px; overflow-y: auto; min-width: 260px;">
            <small class="text-muted d-block mb-2">Ces rôles gardent l'accès malgré le blocage (hiérarchie des rôles incluse).</small>
            {% for code, label in availableRoles %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="allowed_roles[]" value="{{ code }}" id="role-{{ category }}-{{ code }}" {% if code in selectedRoles %}checked{% endif %}>
                    <label class="form-check-label" for="role-{{ category }}-{{ code }}">
                        {{ label }}{% if label != code %} <small class="text-muted">({{ code }})</small>{% endif %}
                    </label>
                </div>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% block body %}
<div class="container mt-4">
    <h1>Gestion des Routes et de la Maintenance</h1>
    <p>Activez ou désactivez le mode maintenance pour des sections entières du site.</p>

    {% for category, routes in categorizedRoutes %}
        <div class="card my-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <h3 class="h5 mb-0 mr-3">Catégorie : <span class="">{{ category }}</span></h3>
                
                {% if maintenance.isCategoryActive(category) %}
                    {% set categoryConfig = maintenance.getCategoryConfig(category) %}
                    {% set currentMode = maintenance.getModeForCategory(category) %}
                    <div class="d-flex align-items-center flex-grow-1 mt-2 mt-md-0">
                        {# Formulaire pour METTRE À JOUR le message et le mode #}
                        <form action="{{ path('dev_maintenance_activate', {category: category}) }}" method="post" class="d-flex align-items-center flex-grow-1 flex-wrap gap-2">
                            <input type="text" name="message" class="form-control form-control-sm" value="{{ categoryConfig.message|default('') }}" placeholder="Message">
                            
                            <select name="mode" class="form-control form-control-sm" style="width: auto;">
                                <option value="block" {% if currentMode == 'block' %}selected{% endif %}>Bloquer l'accès</option>
                                <option value="modal" {% if currentMode == 'modal' %}selected{% endif %}>Afficher un modal</option>
                            </select>

                            {{ _self.roles_dropdown(availableRoles, categoryConfig.allowed_roles|default([]), category) }}
                            
                            <button type="submit" class="btn btn-sm btn-info text-nowrap">Mettre à jour</button>
                        </form>
                        {# Formulaire pour DÉSACTIVER #}
                        <form action="{{ path('dev_maintenance_deactivate', {category: category}) }}" method="post" class="ml-2">
                            <button type="submit" class="btn btn-sm btn-success text-nowrap">Désactiver</button>
                        </form>
                    </div>
                {% else %}
                    {# Formulaire pour ACTIVER #}
                    <form action="{{ path('dev_maintenance_activate', {category: category}) }}" method="post" class="d-flex align-items-center flex-grow-1 mt-2 mt-md-0 flex-wrap gap-2">
                        <input type="text" name="message" class="form-control form-control-sm" placeholder="Message personnalisé (optionnel)">
                        
                        <select name="mode" class="form-control form-control-sm" style="width: auto;">
                            <option value="block">Bloquer l'accès</option>
                            <option value="modal">Afficher un modal</option>
                        </select>

                        {{ _self.roles_dropdown(availableRoles, [], category) }}
                        
                        <button type="submit" class="btn btn-sm btn-danger text-nowrap">Activer</button>
                    </form>
                {% endif %}
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover table-sm mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width: 25%;">Nom de la Route</th>
                            <th style="width: 40%;">Chemin (Path)</th>
                            <th style="width: 35%;">Contrôleur</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for route in routes %}
                            <tr>
                                <td>{{ route.name }}</td>
                                <td>
                                    {% if route.has_required_parameters %}
                                        {{ route.path }}
                                        <small class="text-muted">(requiert des paramètres)</small>
                                    {% else %}
                                        <a href="{{ path(route.name) }}" target="_blank">{{ route.path }}</a>
                                    {% endif %}
                                </td>
                                <td>{{ route.controller }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">Aucune route correspondante trouvée.</div>
    {% endfor %}
</div>

<script>
    document.querySelectorAll('form').forEach(function (form) {
        const mode = form.querySelector('select[name="mode"]');
        const dropdown = form.querySelector('.roles-dropdown');
        if (!mode || !dropdown) return;

        // Les rôles autorisés n'ont de sens qu'en mode blocage
        const toggle = function () { dropdown.classList.toggle('d-none', mode.value !== 'block'); };
        mode.addEventListener('change', toggle);
        toggle();

        const label = dropdown.querySelector('.roles-dropdown-label');
        dropdown.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
            cb.addEventListener('change', function () {
                const count = dropdown.querySelectorAll('input[type="checkbox"]:checked').length;
                label.textContent = count === 0 ? 'Accès autorisé : aucun rôle' : 'Accès autorisé : ' + count + ' rôle(s)';
            });
        });
    });
</script>

<style>
    .gap-2 {
        gap: 0.5rem;
    }
</style>
{% endblock %}