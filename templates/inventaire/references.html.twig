{% extends 'inventaire/layout.html.twig' %}
{% block title %}Inventaire — Références{% endblock %}

{% block sidebar %}
    {% include 'inventaire/sidebar.html.twig' with {
        active_link: 'references'
    } %}
{% endblock %}

{% block body %}
<style>
    .inv-header {
        background: linear-gradient(135deg, #800000 0%, #a00000 100%);
        color: #fff;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
    }
    .inv-header h1 { font-size: 1.25rem; margin: 0; font-weight: 600; }
    .inv-header p  { margin: 0.15rem 0 0; font-size: 0.82rem; opacity: 0.85; }

    .filter-bar { background: #fff; padding: 0.85rem 1rem; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); margin-bottom: 1rem; }

    .table-ref thead th {
        background-color: #800000; color: #fff;
        font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .table-ref tbody tr:hover { background-color: #fff5f5; cursor: pointer; }
    .table-ref td { font-size: 0.85rem; vertical-align: middle; white-space: nowrap; }
    .table-ref tr.match    > td { background-color: #d1e7dd !important; }
    .table-ref tr.mismatch > td { background-color: #f8d7da !important; }
    .table-ref tr.to-process > td { background-color: #fff3cd !important; }
    .table-wrapper { overflow-x: auto; max-height: 65vh; overflow-y: auto; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); }

    .table-detail thead th {
        background-color: #6c757d; color: #fff;
        font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
    }
    .table-detail td { font-size: 0.82rem; vertical-align: middle; }
    .table-detail tr.match    > td { background-color: #d1e7dd !important; }
    .table-detail tr.mismatch > td { background-color: #f8d7da !important; }
    .table-detail tr.to-process > td { background-color: #fff3cd !important; }

    .pagination .page-link { color: #800000; }
    .pagination .page-item.active .page-link { background-color: #800000; border-color: #800000; color: #fff; }
</style>

{# ── En-tête ── #}
<div class="inv-header">
    <h1><i class="fas fa-layer-group me-2"></i>Références</h1>
    <p>{{ total }} référence{{ total > 1 ? 's' : '' }} — tous emplacements confondus</p>
</div>

<div class="container-fluid px-2 px-md-3">

    {# ── Filtre recherche ── #}
    <form method="GET" action="{{ path('app_inventaire_references') }}" class="filter-bar">
        <div class="row g-2 align-items-end">
            <div class="col-9 col-md-6">
                <input type="text" name="q" class="form-control form-control-sm"
                       placeholder="Recherche par code ou nom…" value="{{ filtreQ }}">
            </div>
            <div class="col-3 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-danger w-100"><i class="fas fa-filter"></i></button>
                <a href="{{ path('app_inventaire_references') }}" class="btn btn-sm btn-outline-secondary w-100"><i class="fas fa-times"></i></a>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="ecartSwitch" name="ecart" value="1"
                           {{ filtreEcart ? 'checked' : '' }} onchange="this.form.submit()">
                    <label class="form-check-label" for="ecartSwitch">
                        <i class="fas fa-triangle-exclamation text-danger me-1"></i>Écarts uniquement (comptage total ≠ stock total)
                    </label>
                </div>
            </div>
        </div>
    </form>

    {% if references is empty %}
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>Aucune référence ne correspond à la recherche.</div>
    {% else %}

        <div class="table-wrapper">
            <table class="table table-sm table-bordered table-hover table-ref mb-0">
                <thead>
                    <tr>
                        <th class="text-center" title="À traiter plus tard"><i class="fas fa-flag"></i></th>
                        <th>Code article</th>
                        <th>Nom</th>
                        <th class="text-center">Nb lignes</th>
                        <th class="text-end">Stock total</th>
                        <th class="text-end">Comptage total</th>
                        <th class="text-center">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ref in references %}
                        {% set isMatch    = ref.totalComptage is not null and ref.totalStock is not null and ref.totalComptage|number_format(4, '.', '') == ref.totalStock|number_format(4, '.', '') %}
                        {% set isMismatch = ref.totalComptage is not null and not isMatch %}
                        {% set isPartielATraiter = ref.nbATraiter > 0 and ref.nbATraiter < ref.nbLignes %}
                        <tr class="{{ isMatch ? 'match' : (isMismatch ? 'mismatch' : '') }} {{ ref.nbATraiter > 0 ? 'to-process' : '' }}"
                            data-code="{{ ref.codeArticle }}" data-nom="{{ ref.nom }}">
                            <td class="text-center" onclick="event.stopPropagation()">
                                <input type="checkbox" class="form-check-input a-traiter-ref-check" data-code="{{ ref.codeArticle }}"
                                       title="À traiter plus tard (toutes les lignes)"
                                       {{ ref.nbATraiter == ref.nbLignes ? 'checked' : '' }}
                                       {{ isPartielATraiter ? 'data-indeterminate="1"' : '' }}>
                            </td>
                            <td><code>{{ ref.codeArticle }}</code></td>
                            <td>{{ ref.nom }}</td>
                            <td class="text-center">{{ ref.nbLignes }}</td>
                            <td class="text-end fw-semibold">{% if ref.totalStock is not null %}{{ ref.totalStock|number_format(2, ',', ' ') }}{% endif %}</td>
                            <td class="text-end">{% if ref.totalComptage is not null %}{{ ref.totalComptage|number_format(2, ',', ' ') }}{% endif %}</td>
                            <td class="text-center">
                                {% if isMatch %}
                                    <span class="badge bg-success">OK</span>
                                {% elseif isMismatch %}
                                    <span class="badge bg-danger">Écart</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ── Pagination ── #}
        {% if totalPages > 1 %}
        <nav class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">{{ ((page - 1) * limit) + 1 }}–{{ min(page * limit, total) }} / {{ total }}</small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item {{ page == 1 ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_inventaire_references', app.request.query.all|merge({page: page - 1})) }}"><i class="fas fa-chevron-left"></i></a>
                </li>
                {% for p in max(1, page - 2)..min(totalPages, page + 2) %}
                    <li class="page-item {{ p == page ? 'active' : '' }}">
                        <a class="page-link" href="{{ path('app_inventaire_references', app.request.query.all|merge({page: p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {{ page == totalPages ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_inventaire_references', app.request.query.all|merge({page: page + 1})) }}"><i class="fas fa-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
        {% endif %}

    {% endif %}
</div>

{# ── Modal détail référence ── #}
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailModalTitre"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div id="detailModalLoading" class="text-center text-muted py-3">
                    <i class="fas fa-spinner fa-spin me-2"></i>Chargement…
                </div>
                <div class="table-responsive d-none" id="detailModalTableWrapper">
                    <table class="table table-sm table-bordered table-detail mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" title="À traiter plus tard"><i class="fas fa-flag"></i></th>
                                <th>Emplacement</th>
                                <th>N° lot</th>
                                <th>Caissage</th>
                                <th class="text-end">Stock</th>
                                <th class="text-end">Comptage</th>
                                <th class="text-center">Statut</th>
                                <th>Commentaire</th>
                            </tr>
                        </thead>
                        <tbody id="detailModalBody"></tbody>
                    </table>
                </div>
                <div class="alert alert-danger d-none" id="detailModalError">
                    Impossible de charger le détail de cette référence.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var detailModalEl      = document.getElementById('detailModal');
    var detailModal        = new bootstrap.Modal(detailModalEl);
    var detailModalTitre   = document.getElementById('detailModalTitre');
    var detailModalLoading = document.getElementById('detailModalLoading');
    var detailModalWrapper = document.getElementById('detailModalTableWrapper');
    var detailModalBody    = document.getElementById('detailModalBody');
    var detailModalError   = document.getElementById('detailModalError');

    function formatNumber(value) {
        if (value === null || value === undefined || value === '') return '';
        return parseFloat(value).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function showDetail(codeArticle, nom) {
        detailModalTitre.textContent = nom + ' (' + codeArticle + ')';
        detailModalLoading.classList.remove('d-none');
        detailModalWrapper.classList.add('d-none');
        detailModalError.classList.add('d-none');
        detailModalBody.innerHTML = '';
        detailModal.show();

        fetch('{{ path('app_inventaire_references_detail', {codeArticle: 'CODE_PLACEHOLDER'}) }}'.replace('CODE_PLACEHOLDER', encodeURIComponent(codeArticle)))
            .then(function (r) { if (!r.ok) throw new Error('http'); return r.json(); })
            .then(function (lignes) {
                lignes.forEach(function (l) {
                    var isMatch    = l.comptage !== null && l.stockDisponible !== null && parseFloat(l.comptage) === parseFloat(l.stockDisponible);
                    var isMismatch = l.comptage !== null && !isMatch;
                    var tr = document.createElement('tr');
                    tr.className = (isMatch ? 'match' : (isMismatch ? 'mismatch' : '')) + (l.aTraiter ? ' to-process' : '');

                    var statutHtml = '';
                    if (l.statut === 2) {
                        statutHtml = '<span class="badge bg-success">OK</span>';
                    } else if (l.statut === 3 && (l.caissage || l.attributPrincipal2)) {
                        var attrs = [l.caissage, l.attributPrincipal2].filter(function (v) { return v; }).join(' · ');
                        statutHtml = '<span class="badge bg-danger me-1">Défaut</span><span class="text-muted small">' + attrs + '</span>';
                    }

                    tr.innerHTML =
                        '<td class="text-center"><input type="checkbox" class="form-check-input a-traiter-check" data-id="' + l.id + '"' + (l.aTraiter ? ' checked' : '') + '></td>' +
                        '<td>' + (l.emplacement || '') + '</td>' +
                        '<td class="text-muted">' + (l.numeroLot || '') + '</td>' +
                        '<td>' + (l.caissage || '') + '</td>' +
                        '<td class="text-end">' + formatNumber(l.stockDisponible) + '</td>' +
                        '<td class="text-end">' + formatNumber(l.comptage) + '</td>' +
                        '<td class="text-center">' + statutHtml + '</td>' +
                        '<td>' + (l.commentaire || '') + '</td>';
                    detailModalBody.appendChild(tr);
                });
                bindDetailATraiterChecks();
                detailModalLoading.classList.add('d-none');
                detailModalWrapper.classList.remove('d-none');
            })
            .catch(function () {
                detailModalLoading.classList.add('d-none');
                detailModalError.classList.remove('d-none');
            });
    }

    document.querySelectorAll('.table-ref tbody tr[data-code]').forEach(function (row) {
        row.addEventListener('click', function () {
            showDetail(row.getAttribute('data-code'), row.getAttribute('data-nom'));
        });
    });

    var csrfTokenATraiter    = "{{ csrf_token_a_traiter }}";
    var aTraiterUrlBase      = "{{ path('app_inventaire_article_a_traiter', {id: 'ID_PLACEHOLDER'}) }}";
    var aTraiterRefUrlBase   = "{{ path('app_inventaire_references_a_traiter', {codeArticle: 'CODE_PLACEHOLDER'}) }}";

    function postATraiter(url, checked, onFail) {
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfTokenATraiter, 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ aTraiter: checked })
        })
        .then(function (r) { if (!r.ok) throw new Error('http'); return r.json(); })
        .then(function (data) { if (!data.success) onFail(); })
        .catch(onFail);
    }

    // Case par ligne, dans la modale de détail
    function bindDetailATraiterChecks() {
        detailModalBody.querySelectorAll('.a-traiter-check').forEach(function (checkbox) {
            checkbox.addEventListener('click', function (e) { e.stopPropagation(); });
            checkbox.addEventListener('change', function () {
                var checked = checkbox.checked;
                var row     = checkbox.closest('tr');
                var url     = aTraiterUrlBase.replace('ID_PLACEHOLDER', encodeURIComponent(checkbox.getAttribute('data-id')));
                row.classList.toggle('to-process', checked);
                postATraiter(url, checked, function () {
                    checkbox.checked = !checked;
                    row.classList.toggle('to-process', !checked);
                });
            });
        });
    }

    // Case globale sur la ligne référence (agit sur toutes les lignes de la référence)
    document.querySelectorAll('.a-traiter-ref-check').forEach(function (checkbox) {
        if (checkbox.getAttribute('data-indeterminate') === '1') {
            checkbox.indeterminate = true;
        }
        checkbox.addEventListener('click', function (e) { e.stopPropagation(); });
        checkbox.addEventListener('change', function () {
            var checked = checkbox.checked;
            var row     = checkbox.closest('tr');
            var url     = aTraiterRefUrlBase.replace('CODE_PLACEHOLDER', encodeURIComponent(checkbox.getAttribute('data-code')));
            checkbox.indeterminate = false;
            row.classList.toggle('to-process', checked);
            postATraiter(url, checked, function () {
                checkbox.checked = !checked;
                row.classList.toggle('to-process', !checked);
            });
        });
    });
});
</script>
{% endblock %}
