{% extends 'inventaire/layout.html.twig' %}
{% block title %}Inventaire — Stock articles{% endblock %}

{% block sidebar %}
    {% include 'inventaire/sidebar.html.twig' with {
        active_link:  'stock',
        emplacements: emplacements,
        filtreEmpl:   filtreEmpl
    } %}
{% endblock %}

{% block body %}
<style>
    .inv-header {
        background: linear-gradient(135deg, #800000 0%, #a00000 100%);
        color: #fff;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
    }
    .inv-header h1 { font-size: 1.25rem; margin: 0; font-weight: 600; }
    .inv-header p  { margin: 0.15rem 0 0; font-size: 0.82rem; opacity: 0.85; }

    .stat-card {
        border-left: 4px solid #800000;
        background: #fff;
        border-radius: 6px;
        padding: 0.6rem 0.85rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }
    .stat-card .stat-value { font-size: 1.3rem; font-weight: 700; color: #800000; }
    .stat-card .stat-label { font-size: 0.7rem; color: #6c757d; text-transform: uppercase; letter-spacing: 0.05em; }

    .filter-bar { background: #fff; padding: 0.85rem 1rem; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); margin-bottom: 1rem; }

    /* ── Tableau desktop ── */
    .table-inv thead th {
        background-color: #800000; color: #fff;
        font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em;
        white-space: nowrap; position: sticky; top: 0; z-index: 1;
    }
    .table-inv tbody tr:hover { background-color: #fff5f5; cursor: pointer; }
    .table-inv td { font-size: 0.85rem; vertical-align: middle; white-space: nowrap; }
    .table-inv tr.match    > td { background-color: #d1e7dd !important; }
    .table-inv tr.mismatch > td { background-color: #f8d7da !important; }
    .badge-um { background: #800000; color: #fff; font-size: 0.7rem; padding: 2px 6px; border-radius: 3px; }
    .table-wrapper { overflow-x: auto; max-height: 60vh; overflow-y: auto; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); }

    /* ── Cartes mobile ── */
    .article-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 5px rgba(0,0,0,0.09);
        padding: 0.85rem 1rem;
        margin-bottom: 0.65rem;
        border-left: 4px solid #dee2e6;
        cursor: pointer;
    }
    .article-card.statut-ok      { border-left-color: #198754; }
    .article-card.statut-defaut  { border-left-color: #dc3545; }
    .article-card-nom { font-weight: 600; font-size: 0.95rem; color: #212529; }
    .article-card-code { font-size: 0.75rem; color: #6c757d; font-family: monospace; }
    .article-card-row { display: flex; justify-content: space-between; align-items: center; margin-top: 0.35rem; font-size: 0.82rem; }
    .article-card-stock { font-weight: 700; font-size: 1rem; color: #800000; }

    .pagination .page-link { color: #800000; }
    .pagination .page-item.active .page-link { background-color: #800000; border-color: #800000; color: #fff; }
</style>

{# ── En-tête ── #}
<div class="inv-header">
    <h1><i class="fas fa-boxes me-2"></i>Stock articles</h1>
    <p>{{ total }} ligne{{ total > 1 ? 's' : '' }} trouvée{{ total > 1 ? 's' : '' }}</p>
</div>

<div class="container-fluid px-2 px-md-3">

    {# ── Stats (masquées sur mobile petit) ── #}
    <div class="row g-2 mb-3 d-none d-sm-flex">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-value">{{ total }}</div>
                <div class="stat-label">Articles</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-value">{{ depots|length }}</div>
                <div class="stat-label">Dépôts</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-value">{{ emplacements|length }}</div>
                <div class="stat-label">Emplacements</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-value">{{ page }} / {{ totalPages }}</div>
                <div class="stat-label">Page</div>
            </div>
        </div>
    </div>

    {# ── Filtres ── #}
    <form method="GET" action="{{ path('app_inventaire_index') }}" class="filter-bar">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <input type="text" name="q" class="form-control form-control-sm"
                       placeholder="Recherche…" value="{{ filtreQ }}">
            </div>
            <div class="col-6 col-md-2">
                <select name="depot" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Tous dépôts</option>
                    {% for d in depots %}
                        <option value="{{ d }}" {{ filtreDepot == d ? 'selected' : '' }}>{{ d }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <div class="dropdown" id="emplacementDropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start" type="button"
                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <span id="emplacementDropdownLabel">Tous emplacements</span>
                    </button>
                    <div class="dropdown-menu p-2" style="max-height: 260px; overflow-y: auto; min-width: 220px;">
                        {% for e in emplacements %}
                            <div class="form-check">
                                <input class="form-check-input emplacement-check" type="checkbox" name="emplacement[]"
                                       value="{{ e }}" id="empl-{{ loop.index }}" {{ e in filtreEmpl ? 'checked' : '' }}>
                                <label class="form-check-label" for="empl-{{ loop.index }}">{{ e }}</label>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select name="unite" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Toutes unités</option>
                    {% for u in unites %}
                        <option value="{{ u }}" {{ filtreUnite == u ? 'selected' : '' }}>{{ u }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-danger w-100"><i class="fas fa-filter"></i></button>
                <a href="{{ path('app_inventaire_index') }}" class="btn btn-sm btn-outline-secondary w-100"><i class="fas fa-times"></i></a>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="ecartSwitch" name="ecart" value="1"
                           {{ filtreEcart ? 'checked' : '' }} onchange="this.form.submit()">
                    <label class="form-check-label" for="ecartSwitch">
                        <i class="fas fa-triangle-exclamation text-danger me-1"></i>Écarts uniquement (comptage ≠ stock)
                    </label>
                </div>
            </div>
        </div>
    </form>

    {% if articles is empty %}
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>Aucun article ne correspond aux filtres.</div>
    {% else %}

        {# ── Tableau (≥ md) ── #}
        <div class="table-wrapper d-none d-md-block">
            <table class="table table-sm table-bordered table-hover table-inv mb-0">
                <thead>
                    <tr>
                        <th>Code article</th>
                        <th>Nom</th>
                        <th>N° lot</th>
                        <th>Emplacement</th>
                        <th>Caissage</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Comptage</th>
                        <th class="text-center">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for article in articles %}
                        {% set isMatch    = article.comptage is not null and article.stockDisponible is not null and article.comptage|number_format(4, '.', '') == article.stockDisponible|number_format(4, '.', '') %}
                        {% set isMismatch = article.comptage is not null and not isMatch %}
                        {% set hasCommentaire = article.commentaire is not null and article.commentaire|trim != '' %}
                        <tr class="{{ isMatch ? 'match' : (isMismatch ? 'mismatch' : '') }}"
                            data-nom="{{ article.nom }}" data-commentaire="{{ article.commentaire }}">
                            <td><code>{{ article.codeArticle }}</code></td>
                            <td>{{ article.nom }}{% if hasCommentaire %} <i class="fas fa-comment-dots text-warning ms-1" title="Commentaire disponible"></i>{% endif %}</td>
                            <td class="text-muted">{{ article.numeroLot }}</td>
                            <td>{{ article.emplacement }}</td>
                            <td>{{ article.attributPrincipal1 }}</td>
                            <td class="text-end fw-semibold">
                                {% if article.quantiteAffectee is not null and article.stockDisponible is not null and article.quantiteAffectee|number_format(4, '.', '') != article.stockDisponible|number_format(4, '.', '') %}
                                    Dispo : {{ article.stockDisponible|number_format(2, ',', ' ') }}
                                    <span class="text-muted fw-normal">/ Commande prête qt : {{ article.quantiteAffectee|number_format(2, ',', ' ') }}</span>
                                {% elseif article.quantiteAffectee is not null %}
                                    <span class="text-muted fw-normal">Commande prête qt : {{ article.quantiteAffectee|number_format(2, ',', ' ') }}</span>
                                {% else %}
                                    {% if article.stockDisponible is not null %}Dispo : {{ article.stockDisponible|number_format(2, ',', ' ') }}{% endif %}
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if article.comptage is not null %}{{ article.comptage|number_format(2, ',', ' ') }}{% endif %}
                            </td>
                            <td class="text-center">
                                {% if article.statut == 2 %}
                                    <span class="badge bg-success">OK</span>
                                {% elseif article.statut == 3 and (article.attributPrincipal1 is not null or article.attributPrincipal2 is not null) %}
                                    <span class="badge bg-danger me-1">Défaut</span>
                                    <span class="text-muted small">{{ [article.attributPrincipal1, article.attributPrincipal2]|filter(v => v is not null and v != '')|join(' · ') }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ── Cartes (< md) ── #}
        <div class="d-block d-md-none">
            {% for article in articles %}
                {% set isOk     = article.statut == 2 %}
                {% set isDefaut = article.statut == 3 and (article.attributPrincipal1 is not null or article.attributPrincipal2 is not null) %}
                {% set hasCommentaire = article.commentaire is not null and article.commentaire|trim != '' %}
                <div class="article-card {{ isOk ? 'statut-ok' : (isDefaut ? 'statut-defaut' : '') }}"
                     data-nom="{{ article.nom }}" data-commentaire="{{ article.commentaire }}">
                    <div class="article-card-nom">{{ article.nom }}{% if hasCommentaire %} <i class="fas fa-comment-dots text-warning ms-1" title="Commentaire disponible"></i>{% endif %}</div>
                    <div class="article-card-code">{{ article.codeArticle }}{% if article.numeroLot %} · lot {{ article.numeroLot }}{% endif %}</div>
                    <div class="article-card-row">
                        <span class="text-muted"><i class="fas fa-map-marker-alt me-1"></i>{{ article.emplacement }}</span>
                        <span class="article-card-stock">
                            {% if article.quantiteAffectee is not null and article.stockDisponible is not null and article.quantiteAffectee|number_format(4, '.', '') != article.stockDisponible|number_format(4, '.', '') %}
                                Dispo : {{ article.stockDisponible|number_format(2, ',', ' ') }}
                                <span class="text-muted" style="font-size:0.75rem; font-weight:400;">/ Commande prête qt : {{ article.quantiteAffectee|number_format(2, ',', ' ') }}</span>
                            {% elseif article.quantiteAffectee is not null %}
                                <span class="text-muted" style="font-size:0.75rem; font-weight:400;">Commande prête qt : {{ article.quantiteAffectee|number_format(2, ',', ' ') }}</span>
                            {% else %}
                                {% if article.stockDisponible is not null %}Dispo : {{ article.stockDisponible|number_format(2, ',', ' ') }}{% endif %}
                            {% endif %}
                        </span>
                    </div>
                    {% if article.attributPrincipal1 %}
                        <div class="article-card-row">
                            <span class="text-muted">Caissage</span>
                            <span>{{ article.attributPrincipal1 }}</span>
                        </div>
                    {% endif %}
                    {% if isOk %}<div class="mt-1"><span class="badge bg-success">OK</span></div>{% endif %}
                    {% if isDefaut %}
                        <div class="mt-1">
                            <span class="badge bg-danger me-1">Défaut</span>
                            <span class="text-muted small">{{ [article.attributPrincipal1, article.attributPrincipal2]|filter(v => v is not null and v != '')|join(' · ') }}</span>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {# ── Pagination ── #}
        {% if totalPages > 1 %}
        <nav class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">{{ ((page - 1) * limit) + 1 }}–{{ min(page * limit, total) }} / {{ total }}</small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item {{ page == 1 ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_inventaire_index', app.request.query.all|merge({page: page - 1})) }}"><i class="fas fa-chevron-left"></i></a>
                </li>
                {% for p in max(1, page - 2)..min(totalPages, page + 2) %}
                    <li class="page-item {{ p == page ? 'active' : '' }}">
                        <a class="page-link" href="{{ path('app_inventaire_index', app.request.query.all|merge({page: p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {{ page == totalPages ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_inventaire_index', app.request.query.all|merge({page: page + 1})) }}"><i class="fas fa-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
        {% endif %}

    {% endif %}
</div>

{# ── Modal commentaire ── #}
<div class="modal fade" id="commentaireModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commentaireModalNom"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="commentaireModalTexte"></p>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var emplacementLabel  = document.getElementById('emplacementDropdownLabel');
    var emplacementChecks = document.querySelectorAll('.emplacement-check');

    function updateEmplacementLabel() {
        var checked = Array.prototype.filter.call(emplacementChecks, function (c) { return c.checked; });
        if (checked.length === 0) {
            emplacementLabel.textContent = 'Tous emplacements';
        } else if (checked.length <= 2) {
            emplacementLabel.textContent = checked.map(function (c) { return c.value; }).join(', ');
        } else {
            emplacementLabel.textContent = checked.length + ' emplacements sélectionnés';
        }
    }

    emplacementChecks.forEach(function (c) { c.addEventListener('change', updateEmplacementLabel); });
    updateEmplacementLabel();

    var commentaireModalEl    = document.getElementById('commentaireModal');
    var commentaireModal      = new bootstrap.Modal(commentaireModalEl);
    var commentaireModalNom   = document.getElementById('commentaireModalNom');
    var commentaireModalTexte = document.getElementById('commentaireModalTexte');

    function showCommentaire(el) {
        var commentaire = (el.getAttribute('data-commentaire') || '').trim();
        commentaireModalNom.textContent   = el.getAttribute('data-nom') || '';
        commentaireModalTexte.textContent = commentaire !== '' ? commentaire : 'Aucun commentaire.';
        commentaireModalTexte.classList.toggle('text-muted', commentaire === '');
        commentaireModal.show();
    }

    document.querySelectorAll('.table-inv tbody tr[data-nom]').forEach(function (row) {
        row.addEventListener('click', function () { showCommentaire(row); });
    });
    document.querySelectorAll('.article-card[data-nom]').forEach(function (card) {
        card.addEventListener('click', function () { showCommentaire(card); });
    });
});
</script>
{% endblock %}
