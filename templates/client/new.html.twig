{% extends 'base.html.twig' %}

{% block title %}Ajouter un client{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    <a href="{{ path('app_clients_list') }}" class="btn btn-outline-secondary mb-3">
        <i class="fas fa-arrow-left me-1"></i>Retour à la liste
    </a>

    <div class="d-flex align-items-center mb-4">
        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
            <i class="fas fa-user-plus"></i>
        </div>
        <div>
            <h2 class="mb-0">Ajouter un client</h2>
            <small class="text-muted">Renseignez les informations du client et choisissez ses signataires.</small>
        </div>
    </div>

    {% include 'client/_form.html.twig' with {submit_label: 'Ajouter le client'} %}
</div>
{% endblock %}
