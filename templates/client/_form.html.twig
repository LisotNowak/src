{# Formulaire client partagé entre l'ajout et la modification #}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="row g-4">
        <div class="col-lg-7">
            {# Informations générales #}
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-building text-primary me-2"></i>Informations générales</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">{{ form_row(form.societeNom, {attr: {placeholder: 'Ex. : Abacus Capital'}}) }}</div>
                        <div class="col-md-6">{{ form_row(form.triNom, {attr: {placeholder: 'Nom'}}) }}</div>
                        <div class="col-md-6">{{ form_row(form.triPrenom, {attr: {placeholder: 'Prénom'}}) }}</div>
                        <div class="col-12">{{ form_row(form.categorieEntity) }}</div>
                    </div>
                </div>
            </div>

            {# Adresse #}
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-location-dot text-primary me-2"></i>Adresse</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">{{ form_row(form.adresse1, {attr: {placeholder: 'N° et nom de rue'}}) }}</div>
                        <div class="col-md-4">{{ form_row(form.codePostal) }}</div>
                        <div class="col-md-5">{{ form_row(form.ville) }}</div>
                        <div class="col-md-3">{{ form_row(form.pays) }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# Signataires #}
        <div class="col-lg-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-user-check text-primary me-2"></i>Signataires</h5>
                    <span class="badge bg-primary rounded-pill" id="signatairesCount">0 sélectionné(s)</span>
                </div>
                <div class="card-body">
                    {% if signataires is empty %}
                        <p class="text-muted fst-italic mb-0">Aucun signataire disponible.</p>
                    {% else %}
                        <div class="d-flex gap-2 mb-3">
                            <input type="text" id="signataireSearch" class="form-control form-control-sm" placeholder="Rechercher un signataire...">
                            <button type="button" id="signataireToggleAll" class="btn btn-sm btn-outline-secondary text-nowrap">Tout cocher</button>
                        </div>
                        <div class="list-group" style="max-height: 420px; overflow-y: auto;">
                            {% for signataire in signataires %}
                                <label class="list-group-item list-group-item-action d-flex align-items-center gap-2 signataire-item" for="signataire_{{ signataire.id }}">
                                    <input
                                        class="form-check-input m-0 signataire-checkbox"
                                        type="checkbox"
                                        name="signataires[]"
                                        id="signataire_{{ signataire.id }}"
                                        value="{{ signataire.id }}"
                                        {% if signataire.id in selectedSignataires %}checked{% endif %}
                                    >
                                    <span>{{ signataire.nom }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Actions #}
    <div class="d-flex justify-content-end gap-2 border-top pt-3">
        <a href="{{ path('app_clients_list') }}" class="btn btn-outline-secondary">
            <i class="fas fa-xmark me-1"></i>Annuler
        </a>
        <button type="submit" class="btn btn-success px-4">
            <i class="fas fa-floppy-disk me-1"></i>{{ submit_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}

<style>
.signataire-item:has(.signataire-checkbox:checked) {
    background-color: #e7f1ff;
    font-weight: 500;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = Array.from(document.querySelectorAll('.signataire-checkbox'));
    const counter = document.getElementById('signatairesCount');
    const search = document.getElementById('signataireSearch');
    const toggleAll = document.getElementById('signataireToggleAll');

    const visibleCheckboxes = () => checkboxes.filter(cb => cb.closest('.signataire-item').style.display !== 'none');

    function refreshCounter() {
        const count = checkboxes.filter(cb => cb.checked).length;
        counter.textContent = count + ' sélectionné(s)';
        if (toggleAll) {
            const visibles = visibleCheckboxes();
            toggleAll.textContent = visibles.length > 0 && visibles.every(cb => cb.checked) ? 'Tout décocher' : 'Tout cocher';
        }
    }

    checkboxes.forEach(cb => cb.addEventListener('change', refreshCounter));

    search?.addEventListener('input', function() {
        const filter = this.value.toLowerCase();
        checkboxes.forEach(cb => {
            const item = cb.closest('.signataire-item');
            item.style.display = item.textContent.toLowerCase().includes(filter) ? '' : 'none';
        });
        refreshCounter();
    });

    toggleAll?.addEventListener('click', function() {
        const visibles = visibleCheckboxes();
        const allChecked = visibles.length > 0 && visibles.every(cb => cb.checked);
        visibles.forEach(cb => cb.checked = !allChecked);
        refreshCounter();
    });

    refreshCounter();
});
</script>
