{% extends 'base.html.twig' %}

{% block title %}Modifier un client{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">
                    <i class="bi bi-person-lines-fill"></i> Modifier {{ client.triNom }} {{ client.triPrenom }}
                </h3>
            </div>
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="row g-3">
                        <!-- Informations générales -->
                        <h5 class="text-primary border-bottom pb-2">
                            <i class="bi bi-building"></i> Informations générales
                        </h5>
                        <div class="col-12">
                            {{ form_row(form.societeNom) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.triNom) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.triPrenom) }}
                        </div>

                        <!-- Adresse -->
                        <h5 class="text-primary mt-4 border-bottom pb-2">
                            <i class="bi bi-geo-alt"></i> Adresse
                        </h5>
                        <div class="col-12">
                            {{ form_row(form.adresse1) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.codePostal) }}
                        </div>
                        <div class="col-md-5">
                            {{ form_row(form.ville) }}
                        </div>
                        <div class="col-md-3">
                            {{ form_row(form.pays) }}
                        </div>

                        <!-- Catégorie -->
                        <h5 class="text-primary mt-4 border-bottom pb-2">
                            <i class="bi bi-tags"></i> Catégorie
                        </h5>
                        <div class="col-12">
                            {{ form_row(form.categorieEntity) }}
                        </div>

                        <!-- Signataires -->
                        <h5 class="text-primary mt-4 border-bottom pb-2">
                            <i class="bi bi-person-check"></i> Associer à un ou plusieurs signataires
                        </h5>
                        <div class="col-12">
                            {% if signataires is empty %}
                                <p class="text-muted fst-italic">Aucun signataire disponible.</p>
                            {% else %}
                                <div class="row">
                                    {% for signataire in signataires %}
                                        <div class="col-md-4 form-check mb-1">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="signataires[]"
                                                id="signataire_{{ signataire.id }}"
                                                value="{{ signataire.id }}"
                                                {% if signataire.id in selectedSignataires %}checked{% endif %}
                                            >
                                            <label class="form-check-label" for="signataire_{{ signataire.id }}">
                                                {{ signataire.nom }}
                                            </label>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <!-- Actions -->
                        <div class="col-12 text-end mt-4">
                            <button class="btn btn-success">
                                <i class="bi bi-save"></i> Enregistrer
                            </button>
                            <a href="{{ path('app_clients_list') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour à la liste
                            </a>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
