{% extends 'base.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block body %}
<div class="mt-4">
    <div class="container mt-4">
        <h2 class="mb-4">Liste des clients</h2>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label for="signataire" class="col-form-label fw-bold">Choisir un signataire :</label>
                </div>
                <div class="col-auto">
                    <select id="signataire" name="signataire" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tous les signataires --</option>
                        {% for signataire in signataires %}
                            <option value="{{ signataire.id }}" {% if signataire_selected == signataire.id %}selected{% endif %}>
                                {{ signataire.nom }}
                            </option>
                        {% else %}
                            <option disabled>Aucun signataire trouvé.</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <label for="categorie" class="col-form-label fw-bold">Choisir une catégorie :</label>
                </div>
                <div class="col-auto">
                    <select id="categorie" name="categorie" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Toutes les catégories --</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}" {% if categorie_selected == cat.id %}selected{% endif %}>
                                {{ cat.nomCategorie }}
                            </option>
                        {% else %}
                            <option disabled>Aucune catégorie trouvée.</option>
                        {% endfor %}
                    </select>
                </div>
                {% if categorie_selected %}
                    <div class="col-auto">
                        <label for="societe" class="col-form-label fw-bold">Choisir une société :</label>
                    </div>
                    <div class="col-auto">
                        <select id="societe" name="societe" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Toutes les sociétés --</option>
                            {% for societe in societes %}
                                <option value="{{ societe }}" {% if societe_selected == societe %}selected{% endif %}>{{ societe }}</option>
                            {% else %}
                                <option disabled>Aucune société trouvée.</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </form>
            
        </div>

        <div class="mb-4">
            <a href="{{ path('app_client_associate') }}" class="btn btn-info me-2">Associer des clients</a>
            <button type="button" class="btn btn-warning me-2" data-bs-toggle="modal" data-bs-target="#associateCategorieModal">
                <i class="bi bi-tags"></i> Associer une catégorie de clients
            </button>
            <a href="{{ path('app_client_new') }}" class="btn btn-primary me-2">Ajouter un client</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_client_delete_list') }}" class="btn btn-danger me-2">Supprimer un client</a>
            {% endif %}
            <button type="button" id="toggleVillePaysBtn" class="btn btn-outline-secondary">
                <i class="bi bi-eye-slash"></i> Masquer Ville / Pays
            </button>
        </div>

    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th> <!-- New column for row count -->
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th class="col-ville">Ville</th>
                    <th class="col-pays">Pays</th>
                    <th>Société</th>
                    <th>Catégorie</th>
                    <th>Conserver</th>
                    <th>Imprimer</th>
                    <th class="col-envoi-mail d-none">Envoi mail</th> {# colonne masquée : retirer d-none pour la réafficher #}
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                    {% for client in clients %} {# Mettre à jour ici #}
                        {% set clientAssocs = associations[client.id] ?? [] %}
                        {% set assoc = signataire_selected ? (clientAssocs|filter(a => a.signataire.id == signataire_selected)|first) : null %}
                        <tr class="{% if assoc and assoc.conserver %}row-conserver-oui{% endif %}" 
                            data-client-id="{{ client.id }}"
                            data-client-nom="{{ client.triNom|default('') }}"
                            data-client-prenom="{{ client.triPrenom|default('') }}"
                            data-client-adresse1="{{ client.adresse1|default('') }}"
                            data-client-codepostal="{{ client.codePostal|default('') }}"
                            data-client-ville="{{ client.ville|default('') }}"
                            data-client-pays="{{ client.pays|default('') }}"
                            data-client-societe="{{ client.societeNom|default('') }}"
                            data-client-categorie="{{ client.categorieEntity ? client.categorieEntity.id : '' }}"
                            style="cursor: pointer;">
                            
                            <td data-bs-toggle="modal" data-bs-target="#addressModal">{{ loop.index }}</td>
                            <td data-bs-toggle="modal" data-bs-target="#addressModal">{{ client.triNom }}</td>
                            <td data-bs-toggle="modal" data-bs-target="#addressModal">{{ client.triPrenom }}</td>
                            <td class="col-ville" data-bs-toggle="modal" data-bs-target="#addressModal">{{ client.ville }}</td>
                            <td class="col-pays" data-bs-toggle="modal" data-bs-target="#addressModal">{{ client.pays }}</td>
                            <td data-bs-toggle="modal" data-bs-target="#addressModal">{{ client.societeNom }}</td>
                            <td data-bs-toggle="modal" data-bs-target="#addressModal">{{ client.categorieEntity ? client.categorieEntity.nomCategorie : 'Aucune' }}</td>
                            
                            <td>
                                {% if signataire_selected %}
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm conserver-btn conserver-oui"
                                                data-client-id="{{ client.id }}" data-signataire="{{ assoc ? assoc.signataire.id : signataire_selected }}"
                                                data-value="1" style="background-color: {% if assoc and assoc.conserver %}green{% else %}gray{% endif %}; color: white;">
                                            Oui
                                        </button>
                                        <button type="button" class="btn btn-sm conserver-btn conserver-non"
                                                data-client-id="{{ client.id }}" data-signataire="{{ assoc ? assoc.signataire.id : signataire_selected }}"
                                                data-value="0" style="background-color: {% if assoc and not assoc.conserver %}red{% else %}gray{% endif %}; color: white;">
                                            Non
                                        </button>
                                    </div>
                                {% else %}
                                    <span class="text-muted small">Choisir un signataire</span>
                                {% endif %}
                            </td>

                            <td>
                                {% if signataire_selected %}
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm imprimer-btn imprimer-oui"
                                                data-client-id="{{ client.id }}" data-signataire="{{ assoc ? assoc.signataire.id : signataire_selected }}"
                                                data-value="1" style="background-color: {% if assoc and assoc.imprimer %}green{% else %}gray{% endif %}; color: white;">
                                            Oui
                                        </button>
                                        <button type="button" class="btn btn-sm imprimer-btn imprimer-non"
                                                data-client-id="{{ client.id }}" data-signataire="{{ assoc ? assoc.signataire.id : signataire_selected }}"
                                                data-value="0" style="background-color: {% if assoc and not assoc.imprimer %}red{% else %}gray{% endif %}; color: white;">
                                            Non
                                        </button>
                                    </div>
                                {% else %}
                                    <span class="text-muted small">Choisir un signataire</span>
                                {% endif %}
                            </td>

                            <td class="col-envoi-mail d-none">
                                {% if signataire_selected %}
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm envoi-mail-btn envoi-mail-oui"
                                                data-client-id="{{ client.id }}" data-signataire="{{ assoc ? assoc.signataire.id : signataire_selected }}"
                                                data-value="1" style="background-color: {% if assoc and assoc.envoiMail %}green{% else %}gray{% endif %}; color: white;">
                                            Oui
                                        </button>
                                        <button type="button" class="btn btn-sm envoi-mail-btn envoi-mail-non"
                                                data-client-id="{{ client.id }}" data-signataire="{{ assoc ? assoc.signataire.id : signataire_selected }}"
                                                data-value="0" style="background-color: {% if assoc and not assoc.envoiMail %}red{% else %}gray{% endif %}; color: white;">
                                            Non
                                        </button>
                                    </div>
                                {% else %}
                                    <span class="text-muted small">Choisir un signataire</span>
                                {% endif %}
                            </td>

                            <td>
                                <a href="{{ path('app_client_edit', {id: client.id}) }}" class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation();">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" class="text-center text-muted">Aucun client trouvé.</td>
                        </tr>
                    {% endfor %}
            </tbody>


        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="addressModalLabel">Modifier les informations</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <form id="addressForm">
            <input type="hidden" id="modalClientId">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nom</label>
                    <input type="text" class="form-control" id="modalNom">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Prénom</label>
                    <input type="text" class="form-control" id="modalPrenom">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Adresse</label>
                <input type="text" class="form-control" id="modalAdresse1">
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Code postal</label>
                    <input type="text" class="form-control" id="modalCodePostal">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Ville</label>
                    <input type="text" class="form-control" id="modalVille">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Pays</label>
                    <input type="text" class="form-control" id="modalPays">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Société</label>
                <input type="text" class="form-control" id="modalSociete">
            </div>

            <div class="mb-3">
                <label class="form-label">Catégorie</label>
                <select class="form-select" id="modalCategorie">
                    <option value="">-- Aucune --</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}">{{ cat.nomCategorie }}</option>
                    {% endfor %}
                </select>
            </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="button" class="btn btn-primary" id="saveAddressBtn">Enregistrer</button>
      </div>

    </div>
  </div>
</div>

<!-- Modal : associer une catégorie de clients à un signataire -->
<div class="modal fade" id="associateCategorieModal" tabindex="-1" aria-labelledby="associateCategorieModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="associateCategorieModalLabel">Associer une catégorie de clients</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label for="assocCatSignataire" class="form-label fw-bold">Signataire</label>
          <select id="assocCatSignataire" class="form-select">
            <option value="">-- Choisir un signataire --</option>
            {% for signataire in signataires %}
              <option value="{{ signataire.id }}" {% if signataire_selected == signataire.id %}selected{% endif %}>{{ signataire.nom }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="mb-3">
          <label for="assocCatCategorie" class="form-label fw-bold">Catégorie</label>
          <select id="assocCatCategorie" class="form-select">
            <option value="">-- Toutes les catégories --</option>
            {% for cat in categories %}
              <option value="{{ cat.id }}" {% if categorie_selected == cat.id %}selected{% endif %}>{{ cat.nomCategorie }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="mb-3 d-none" id="assocCatSocieteGroup">
          <label for="assocCatSocieteSearch" class="form-label fw-bold">Société</label>
          <input type="search" id="assocCatSocieteSearch" class="form-control mb-2" placeholder="Rechercher une société dans la catégorie..." autocomplete="off">
          <select id="assocCatSociete" class="form-select" size="6">
            <option value="">-- Toutes les sociétés --</option>
          </select>
        </div>
        <div id="assocCatError" class="alert alert-danger d-none mb-0"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-warning" id="assocCatSubmitBtn">Associer</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal : résultat de l'association -->
<div class="modal fade" id="associateCategorieResultModal" tabindex="-1" aria-labelledby="associateCategorieResultModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="associateCategorieResultModalLabel">Association terminée</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <ul class="list-group">
          <li class="list-group-item d-flex justify-content-between align-items-center">
            Total ajoutés
            <span class="badge bg-success rounded-pill" id="assocCatAdded">0</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            Total déjà présents
            <span class="badge bg-secondary rounded-pill" id="assocCatExisting">0</span>
          </li>
        </ul>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

<style>
/* applique la couleur verte clair à toutes les cellules de la ligne */
.row-conserver-oui td {
    background-color: #d4edda !important; /* vert clair */
}
</style>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // --- Script pour masquer/afficher les colonnes Ville / Pays ---
    const toggleVillePaysBtn = document.getElementById('toggleVillePaysBtn');
    const VILLE_PAYS_STORAGE_KEY = 'clients_hide_ville_pays';

    function applyVillePaysVisibility(hidden) {
        document.querySelectorAll('.col-ville, .col-pays').forEach(function(el) {
            el.style.display = hidden ? 'none' : '';
        });
        toggleVillePaysBtn.innerHTML = hidden
            ? '<i class="bi bi-eye"></i> Afficher Ville / Pays'
            : '<i class="bi bi-eye-slash"></i> Masquer Ville / Pays';
    }

    let villePaysHidden = false;
    try {
        villePaysHidden = localStorage.getItem(VILLE_PAYS_STORAGE_KEY) === '1';
    } catch (e) {}
    applyVillePaysVisibility(villePaysHidden);

    toggleVillePaysBtn.addEventListener('click', function() {
        villePaysHidden = !villePaysHidden;
        try {
            localStorage.setItem(VILLE_PAYS_STORAGE_KEY, villePaysHidden ? '1' : '0');
        } catch (e) {}
        applyVillePaysVisibility(villePaysHidden);
    });

    // --- Script pour associer une catégorie de clients à un signataire ---
    const assocCatModalEl = document.getElementById('associateCategorieModal');
    const assocCatResultModalEl = document.getElementById('associateCategorieResultModal');
    const assocCatSubmitBtn = document.getElementById('assocCatSubmitBtn');
    const assocCatError = document.getElementById('assocCatError');
    let assocCatHasAdded = false;

    function showAssocCatError(message) {
        assocCatError.textContent = message;
        assocCatError.classList.remove('d-none');
    }

    // Filtre société : affiché uniquement quand une catégorie est choisie
    const societesParCategorie = {{ societes_par_categorie|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }};
    const assocCatCategorieSelect = document.getElementById('assocCatCategorie');
    const assocCatSocieteGroup = document.getElementById('assocCatSocieteGroup');
    const assocCatSocieteSelect = document.getElementById('assocCatSociete');

    const assocCatSocieteSearch = document.getElementById('assocCatSocieteSearch');

    // Normalise pour une recherche insensible à la casse et aux accents
    function normalizeText(text) {
        return text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }

    // Affiche les sociétés de la catégorie choisie correspondant à la recherche
    function renderAssocCatSocietes() {
        const societes = societesParCategorie[assocCatCategorieSelect.value] || [];
        const search = normalizeText(assocCatSocieteSearch.value.trim());
        const previous = assocCatSocieteSelect.value;

        assocCatSocieteSelect.innerHTML = '<option value="">-- Toutes les sociétés --</option>';
        societes
            .filter(societe => !search || normalizeText(societe).includes(search))
            .forEach(function(societe) {
                const option = document.createElement('option');
                option.value = societe;
                option.textContent = societe;
                assocCatSocieteSelect.appendChild(option);
            });

        // Conserve la sélection si elle est toujours visible, sinon revient à "Toutes"
        assocCatSocieteSelect.value = previous;
        if (assocCatSocieteSelect.selectedIndex === -1) {
            assocCatSocieteSelect.value = '';
        }
    }

    function refreshAssocCatSocietes() {
        const societes = societesParCategorie[assocCatCategorieSelect.value] || [];
        assocCatSocieteSearch.value = '';
        assocCatSocieteSelect.value = '';
        renderAssocCatSocietes();
        assocCatSocieteGroup.classList.toggle('d-none', !assocCatCategorieSelect.value || societes.length === 0);
    }

    assocCatCategorieSelect.addEventListener('change', refreshAssocCatSocietes);
    assocCatSocieteSearch.addEventListener('input', renderAssocCatSocietes);

    assocCatModalEl.addEventListener('show.bs.modal', function() {
        assocCatError.classList.add('d-none');
        refreshAssocCatSocietes();
    });

    assocCatSubmitBtn.addEventListener('click', function() {
        const signataire = document.getElementById('assocCatSignataire').value;
        const categorie = assocCatCategorieSelect.value;
        const societe = categorie ? assocCatSocieteSelect.value : '';

        if (!signataire) {
            showAssocCatError('Veuillez choisir un signataire.');
            return;
        }

        assocCatSubmitBtn.disabled = true;
        assocCatError.classList.add('d-none');

        fetch("{{ path('app_client_associate_categorie') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-TOKEN': '{{ csrf_token('associate_categorie') }}'
            },
            body: JSON.stringify({ signataire: signataire, categorie: categorie, societe: societe })
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                showAssocCatError(data.error || 'Erreur lors de l\'association.');
                return;
            }
            document.getElementById('assocCatAdded').textContent = data.added;
            document.getElementById('assocCatExisting').textContent = data.alreadyPresent;
            assocCatHasAdded = data.added > 0;

            bootstrap.Modal.getOrCreateInstance(assocCatModalEl).hide();
            bootstrap.Modal.getOrCreateInstance(assocCatResultModalEl).show();
        })
        .catch(() => showAssocCatError('Erreur lors de l\'association.'))
        .finally(() => { assocCatSubmitBtn.disabled = false; });
    });

    // Recharge la liste à la fermeture si de nouvelles associations ont été créées
    assocCatResultModalEl.addEventListener('hidden.bs.modal', function() {
        if (assocCatHasAdded) {
            window.location.reload();
        }
    });

    // --- Script pour les boutons Oui/Non ---
    document.querySelectorAll('.conserver-btn, .imprimer-btn, .envoi-mail-btn').forEach(function(button) {
        button.addEventListener('click', function(event) {
            event.stopPropagation(); // Empêche l'ouverture de la modale
            const clientId = this.dataset.clientId;
            const value = this.dataset.value;
            const signataire = this.dataset.signataire;
            let field = 'imprimer';
            if (this.classList.contains('conserver-btn')) field = 'conserver';
            if (this.classList.contains('envoi-mail-btn')) field = 'envoiMail';

            const row = this.closest('tr'); // récupère la ligne courante

            fetch("{{ path('app_clients_update_field') }}", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-TOKEN': '{{ csrf_token('update_client_field') }}'
                },
                body: JSON.stringify({ id: clientId, signataire: signataire, field: field, value: value })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Réinitialiser les couleurs des boutons du groupe
                    const group = this.parentElement;
                    group.querySelectorAll('button').forEach(btn => btn.style.backgroundColor = 'gray');

                    // Gestion spécifique du champ "conserver"
                    if (field === 'conserver') {
                        if (value === '1') {
                            this.style.backgroundColor = 'green';
                            row.classList.add('row-conserver-oui'); // applique la classe
                        } else {
                            this.style.backgroundColor = 'red';
                            row.classList.remove('row-conserver-oui'); // supprime la classe
                        }
                    } else if (field === 'imprimer') {
                        this.style.backgroundColor = value === '1' ? 'green' : 'red';
                    } else if (field === 'envoiMail') {
                        this.style.backgroundColor = value === '1' ? 'green' : 'red';
                    }
                } else {
                    alert('Erreur lors de la sauvegarde');
                }
            })
            .catch(() => alert('Erreur lors de la sauvegarde'));
        });
    });

    // --- Script pour la modale d'adresse ---
    const addressModal = document.getElementById('addressModal');
    let currentRow = null; // Pour garder une référence à la ligne cliquée

    addressModal.addEventListener('show.bs.modal', function (event) {
        const td = event.relatedTarget; // c'est le <td>
        const row = td.closest('tr');  // remonte jusqu'au <tr>
        currentRow = row;

        const clientId = row.dataset.clientId;
        const adresse1 = row.dataset.clientAdresse1;
        const codePostal = row.dataset.clientCodepostal;
        const ville = row.dataset.clientVille;
        const pays = row.dataset.clientPays;
        const nom = row.dataset.clientNom;
        const prenom = row.dataset.clientPrenom;
        const societe = row.dataset.clientSociete;
        const categorieId = row.dataset.clientCategorie;

        document.getElementById('modalNom').value = nom;
        document.getElementById('modalPrenom').value = prenom;
        document.getElementById('modalClientId').value = clientId;
        document.getElementById('modalAdresse1').value = adresse1;
        document.getElementById('modalCodePostal').value = codePostal;
        document.getElementById('modalVille').value = ville;
        document.getElementById('modalPays').value = pays;
        document.getElementById('modalSociete').value = societe || '';
        const categorieSelect = document.getElementById('modalCategorie');
        if (categorieSelect) {
            categorieSelect.value = categorieId || '';
        }

    });


        document.getElementById('saveAddressBtn').addEventListener('click', function() {
        const clientId = document.getElementById('modalClientId').value;
        const urlTemplate = "{{ path('app_client_update_address', {id: 'ID_PLACEHOLDER'}) }}";
        const url = urlTemplate.replace('ID_PLACEHOLDER', clientId);

        const data = {
            nom: document.getElementById('modalNom').value,
            prenom: document.getElementById('modalPrenom').value,
            adresse1: document.getElementById('modalAdresse1').value,
            adresse2: document.getElementById('modalAdresse2')?.value || '',
            codePostal: document.getElementById('modalCodePostal').value,
            ville: document.getElementById('modalVille').value,
            pays: document.getElementById('modalPays').value,
            societe: document.getElementById('modalSociete').value,
            categorie: document.getElementById('modalCategorie').value, // ⚡ ajouté
        };

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success && currentRow) {
                // Mise à jour du tableau côté client
                currentRow.cells[1].textContent = data.nom || '';
                currentRow.cells[2].textContent = data.prenom || '';
                currentRow.cells[3].textContent = data.ville || '';
                currentRow.cells[4].textContent = data.pays || '';
                currentRow.cells[5].textContent = data.societe || '';
                
                // Mettre à jour la catégorie
                const categorieSelect = document.getElementById('modalCategorie');
                const selectedOption = categorieSelect.options[categorieSelect.selectedIndex];
                currentRow.cells[6].textContent = selectedOption ? selectedOption.text : 'Aucune';

                // Mise à jour des data-* pour les futures ouvertures de modale
                currentRow.dataset.clientNom = data.nom || '';
                currentRow.dataset.clientPrenom = data.prenom || '';
                currentRow.dataset.clientAdresse1 = data.adresse1 || '';
                currentRow.dataset.clientAdresse2 = data.adresse2 || '';
                currentRow.dataset.clientCodepostal = data.codePostal || '';
                currentRow.dataset.clientVille = data.ville || '';
                currentRow.dataset.clientPays = data.pays || '';
                currentRow.dataset.clientSociete = data.societe || '';
                currentRow.dataset.clientCategorie = data.categorie || '';

                // Fermer la modale
                $('#addressModal').modal('hide');
            } else {
                alert('Erreur lors de la mise à jour de l\'adresse.');
            }
        })
        .catch((error) => {
            console.error('Erreur:', error);
            alert('Une erreur est survenue lors de la mise à jour de l\'affichage.');
        });
    });
});
</script>
{% endblock %}
