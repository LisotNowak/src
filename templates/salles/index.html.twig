{% extends 'base.html.twig' %}
{% block title %}Réservation de salles{% endblock %}

{% block body %}
<style>
    /* Styles limités à #salles-app */
    #salles-app {
        --bg:#f4f5f7; --panel:#fff; --panel2:#eef0f3; --line:#d9dde3; --text:#1b1f24; --muted:#5f6b7a;
        --accent:#800000; --libre:#1f9d55; --occupe:#c2410c; --moi:#2563eb; --prov:#a3a3a3;
        --col-salle:210px; --radius:10px;
        background:var(--bg); color:var(--text); font-size:14px; min-height:calc(100vh - 56px);
    }
    #salles-app .sl-header{background:var(--panel);border-bottom:1px solid var(--line);padding:.85rem 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    #salles-app .sl-header h1{font-size:1.2rem;margin:0;font-weight:600}
    #salles-app .sl-header h1 i{color:var(--accent)}
    #salles-app .sl-header p{margin:.1rem 0 0;font-size:.8rem;color:var(--muted)}
    #salles-app .sl-nav{display:flex;gap:6px;align-items:center;margin-left:auto;flex-wrap:wrap}
    #salles-app .sl-btn{border:1px solid var(--line);background:var(--panel);color:var(--text);padding:6px 12px;border-radius:8px}
    #salles-app .sl-btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}
    #salles-app .sl-btn:disabled{opacity:.6;cursor:progress}
    #salles-app .sl-main{padding:20px;max-width:1600px;margin:0 auto}
    #salles-app h2{font-size:16px;font-weight:600;margin:0 0 12px}
    #salles-app h2 small{font-weight:400;color:var(--muted);font-size:13px}

    /* État actuel des salles */
    #salles-app .sl-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;margin-bottom:24px}
    #salles-app .sl-card{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--libre);border-radius:8px;padding:12px 14px;cursor:pointer}
    #salles-app .sl-card:hover{border-color:var(--accent)}
    #salles-app .sl-card.occupee{border-left-color:var(--occupe)}
    #salles-app .sl-card.erreur{border-left-color:#999}
    #salles-app .sl-card h3{font-size:15px;margin:0 0 4px;display:flex;justify-content:space-between;gap:8px}
    #salles-app .sl-etat{font-size:12px;font-weight:600;padding:1px 8px;border-radius:999px;white-space:nowrap;align-self:flex-start}
    #salles-app .sl-etat.libre{background:#dcfce7;color:#166534}
    #salles-app .sl-etat.occupee{background:#ffedd5;color:#9a3412}
    #salles-app .sl-meta{color:var(--muted);font-size:12.5px;display:flex;gap:10px;flex-wrap:wrap}
    #salles-app .sl-now{font-size:13px;margin-top:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

    /* Planning */
    #salles-app .sl-planning{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow-x:auto}
    #salles-app .sl-grid{min-width:900px;position:relative}
    #salles-app .sl-row{display:flex;border-bottom:1px solid var(--line);min-height:54px}
    #salles-app .sl-row:last-child{border-bottom:0}
    #salles-app .sl-row.head{min-height:30px;background:var(--panel2);position:sticky;top:0;z-index:3}
    #salles-app .sl-name{width:var(--col-salle);flex-shrink:0;padding:8px 12px;border-right:1px solid var(--line);background:var(--panel);position:sticky;left:0;z-index:2}
    #salles-app .sl-row.head .sl-name{background:var(--panel2)}
    #salles-app .sl-name b{display:block;font-size:13.5px}
    #salles-app .sl-name span{font-size:11.5px;color:var(--muted)}
    #salles-app .sl-track{flex:1;position:relative;cursor:copy}
    #salles-app .sl-row.head .sl-track{cursor:default}
    #salles-app .sl-hour{position:absolute;top:0;bottom:0;border-left:1px solid var(--panel2)}
    #salles-app .sl-row.head .sl-hour{border-left-color:var(--line);font-size:11px;color:var(--muted);padding:7px 0 0 4px}
    #salles-app .sl-ev{position:absolute;top:5px;bottom:5px;border-radius:6px;background:#fed7aa;border-left:4px solid var(--occupe);padding:3px 6px;font-size:12px;line-height:1.25;overflow:hidden;cursor:pointer;z-index:1}
    #salles-app .sl-ev:hover{filter:brightness(.95);z-index:4;box-shadow:0 2px 8px rgba(0,0,0,.15)}
    #salles-app .sl-ev.moi{background:#dbeafe;border-left-color:var(--moi)}
    #salles-app .sl-ev.tentative{background:repeating-linear-gradient(45deg,#fff7ed,#fff7ed 6px,#fed7aa 6px,#fed7aa 12px)}
    #salles-app .sl-ev b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    #salles-app .sl-ev span{color:#444;white-space:nowrap}
    #salles-app .sl-nowline{position:absolute;top:0;bottom:0;width:2px;background:#dc2626;z-index:5;pointer-events:none}
    #salles-app .sl-err{color:#b91c1c;font-size:12px;padding:16px 10px}
    #salles-app .sl-legend{display:flex;gap:16px;font-size:12px;color:var(--muted);margin-top:8px;flex-wrap:wrap}
    #salles-app .sl-legend i{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:4px}
    #salles-app .sl-alert{padding:10px 14px;border-radius:8px;margin-bottom:14px}
    #salles-app .sl-alert.err{background:#fee2e2;color:#991b1b}
    #salles-app .sl-alert.ok{background:#dcfce7;color:#166534}
    #salles-app .sl-loading{color:var(--muted);padding:30px;text-align:center}
    #sl-detail dt{color:#5f6b7a;font-weight:500}
    #sl-detail .sl-apercu{white-space:pre-wrap;background:#f4f5f7;border-radius:6px;padding:8px 10px;font-size:13px}
</style>

<div id="salles-app"
     data-planning="{{ path('app_salles_planning') }}"
     data-reserver="{{ path('app_salles_reserver') }}"
     data-annuler="{{ path('app_salles_annuler') }}"
     data-rafraichir="{{ path('app_salles_rafraichir') }}"
     data-csrf="{{ csrf_token('salles') }}"
     data-moi="{{ moi }}">

    <div class="sl-header">
        <div>
            <h1><i class="fa-solid fa-door-open me-2"></i>Réservation de salles</h1>
            <p>Calendriers Outlook des salles de réunion — vos réservations apparaissent dans votre agenda Outlook</p>
        </div>
        <div class="sl-nav">
            <button class="sl-btn" id="sl-prev" title="Jour précédent"><i class="fa-solid fa-chevron-left"></i></button>
            <button class="sl-btn" id="sl-today">Aujourd'hui</button>
            <button class="sl-btn" id="sl-next" title="Jour suivant"><i class="fa-solid fa-chevron-right"></i></button>
            <input type="date" class="form-control form-control-sm" id="sl-date" style="width:auto">
            <button class="sl-btn" id="sl-reload" title="Actualiser"><i class="fa-solid fa-rotate"></i></button>
            {% if is_granted('ROLE_ADMIN') %}
                <button class="sl-btn" id="sl-refresh-rooms" title="Relire la liste des salles dans Exchange"><i class="fa-solid fa-list"></i></button>
            {% endif %}
            <button class="sl-btn primary" id="sl-new"><i class="fa-solid fa-plus me-1"></i>Réserver</button>
        </div>
    </div>

    <div class="sl-main">
        <div id="sl-message"></div>

        <section id="sl-now-section">
            <h2>En ce moment <small id="sl-now-time"></small></h2>
            <div class="sl-cards" id="sl-cards"></div>
        </section>

        <h2>Planning <small id="sl-day-label"></small></h2>
        <div class="sl-planning"><div class="sl-grid" id="sl-grid"><div class="sl-loading">Chargement des calendriers Outlook…</div></div></div>
        <div class="sl-legend">
            <span><i style="background:#fed7aa;border-left:3px solid var(--occupe)"></i>Réservée</span>
            <span><i style="background:#dbeafe;border-left:3px solid var(--moi)"></i>Mes réservations</span>
            <span><i style="background:repeating-linear-gradient(45deg,#fff7ed,#fff7ed 3px,#fed7aa 3px,#fed7aa 6px)"></i>Provisoire</span>
            <span>Cliquez sur un créneau libre pour réserver, sur une réservation pour voir le détail.</span>
        </div>
    </div>

    {# ── Détail d'une réservation ── #}
    <div class="modal fade" id="sl-detail" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sl-detail-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body" id="sl-detail-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger me-auto d-none" id="sl-cancel-btn"><i class="fa-solid fa-ban me-1"></i>Annuler la réservation</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>

    {# ── Nouvelle réservation ── #}
    <div class="modal fade" id="sl-book" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="sl-book-form" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-solid fa-calendar-plus me-2"></i>Réserver une salle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div id="sl-book-error" class="alert alert-danger d-none"></div>
                    <div class="mb-3">
                        <label class="form-label" for="sl-f-salle">Salle</label>
                        <select class="form-select" id="sl-f-salle" required></select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-5">
                            <label class="form-label" for="sl-f-date">Date</label>
                            <input type="date" class="form-control" id="sl-f-date" required>
                        </div>
                        <div class="col-7">
                            <label class="form-label" for="sl-f-debut">Horaires</label>
                            <div class="input-group">
                                <input type="time" class="form-control" id="sl-f-debut" step="300" required>
                                <span class="input-group-text">à</span>
                                <input type="time" class="form-control" id="sl-f-fin" step="300" required>
                            </div>
                        </div>
                    </div>
                    <div id="sl-f-dispo" class="small mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label" for="sl-f-sujet">Objet</label>
                        <input type="text" class="form-control" id="sl-f-sujet" maxlength="255" required placeholder="Ex. : Réunion d'équipe">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sl-f-participants">Participants <span class="text-muted small">(facultatif — adresses e-mail séparées par des virgules)</span></label>
                        <input type="text" class="form-control" id="sl-f-participants" placeholder="prenom.nom@chateau-latour.com">
                    </div>
                    <div class="mb-1">
                        <label class="form-label" for="sl-f-description">Description <span class="text-muted small">(facultatif)</span></label>
                        <textarea class="form-control" id="sl-f-description" rows="3" maxlength="5000"></textarea>
                    </div>
                    <div class="form-text">La réunion est créée dans votre agenda Outlook ({{ moi }}) ; la salle et les participants reçoivent l'invitation.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary" id="sl-book-submit" style="background:#800000;border-color:#800000">Réserver</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    const app = document.getElementById('salles-app');
    const URLS = app.dataset, CSRF = app.dataset.csrf;
    const H_MIN = 7, H_MAX = 20;           // plage affichée par défaut, élargie si des réservations débordent
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const pad = (n) => String(n).padStart(2, '0');
    const isoJour = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    const hm = (iso) => iso ? iso.slice(11, 16) : '';
    // Les dates renvoyées par le serveur sont en heure de Paris (« 2026-11-09T14:30:00+01:00 »)
    const minutesDans = (iso, jour) => {
        const d = iso.slice(0, 10);
        if (d < jour) return 0;
        if (d > jour) return 24 * 60;
        return parseInt(iso.slice(11, 13), 10) * 60 + parseInt(iso.slice(14, 16), 10);
    };
    const REPONSES = {accepted: 'Accepté', declined: 'Refusé', tentativelyAccepted: 'Provisoire', none: 'Sans réponse', notResponded: 'Sans réponse', organizer: 'Organisateur'};

    let jour = isoJour(new Date());
    let salles = [];
    const modalDetail = new bootstrap.Modal($('sl-detail'));
    const modalBook = new bootstrap.Modal($('sl-book'));

    async function api(url, body) {
        const opts = body === undefined ? {} : {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'X-CSRF-TOKEN': CSRF},
            body: JSON.stringify(body),
        };
        const r = await fetch(url, opts);
        let data;
        try { data = await r.json(); } catch (e) {
            // Page HTML au lieu de JSON : session expirée (redirection vers la connexion)
            throw new Error('Session expirée : rechargez la page pour vous reconnecter.');
        }
        if (!r.ok) throw new Error(data.message || ('Erreur ' + r.status));
        return data;
    }

    function message(texte, type) {
        $('sl-message').innerHTML = texte ? '<div class="sl-alert ' + type + '">' + esc(texte) + '</div>' : '';
    }

    // ── Chargement ───────────────────────────────────────────────────────
    async function charger(silencieux) {
        $('sl-date').value = jour;
        const d = new Date(jour + 'T12:00:00');
        $('sl-day-label').textContent = d.toLocaleDateString('fr-FR', {weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'});
        if (!silencieux) $('sl-grid').innerHTML = '<div class="sl-loading">Chargement des calendriers Outlook…</div>';
        try {
            const data = await api(URLS.planning + '?jour=' + encodeURIComponent(jour));
            if (data.jour !== jour) return;          // réponse d'un jour quitté entre-temps
            salles = data.salles;
            if (!silencieux) message('');
            dessiner();
        } catch (e) {
            $('sl-grid').innerHTML = '';
            $('sl-cards').innerHTML = '';
            message(e.message, 'err');
        }
    }

    function dessiner() {
        dessinerCartes();
        dessinerPlanning();
    }

    // ── En ce moment (uniquement pour aujourd'hui) ───────────────────────
    function dessinerCartes() {
        const aujourdHui = isoJour(new Date());
        $('sl-now-section').style.display = jour === aujourdHui ? '' : 'none';
        if (jour !== aujourdHui) return;

        const now = new Date();
        const nowMin = now.getHours() * 60 + now.getMinutes();
        $('sl-now-time').textContent = '(' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ')';

        $('sl-cards').innerHTML = salles.map((s, i) => {
            const meta = [s.capacite ? '<span><i class="fa-solid fa-user-group"></i> ' + s.capacite + '</span>' : '',
                          s.batiment ? '<span><i class="fa-solid fa-building"></i> ' + esc(s.batiment) + (s.etage ? ' · ét. ' + esc(s.etage) : '') + '</span>' : '',
                          s.equipements.length ? '<span>' + esc(s.equipements.join(', ')) + '</span>' : ''].join('');
            if (s.erreur) {
                return '<div class="sl-card erreur"><h3>' + esc(s.nom) + '</h3><div class="sl-meta">' + meta + '</div><div class="sl-now text-danger" title="' + esc(s.erreur) + '">Calendrier illisible</div></div>';
            }
            const resas = s.reservations.filter(r => r.statut !== 'free');
            const actuelle = resas.find(r => minutesDans(r.debut, jour) <= nowMin && minutesDans(r.fin, jour) > nowMin);
            const prochaine = resas.find(r => minutesDans(r.debut, jour) > nowMin);
            let etat, ligne;
            if (actuelle) {
                etat = '<span class="sl-etat occupee">Occupée</span>';
                ligne = 'Jusqu\'à ' + (actuelle.fin.slice(0, 10) > jour ? 'demain' : hm(actuelle.fin)) + ' — ' + esc(actuelle.sujet);
            } else {
                etat = '<span class="sl-etat libre">Libre</span>';
                ligne = prochaine ? 'Jusqu\'à ' + hm(prochaine.debut) + ' (' + esc(prochaine.sujet) + ')' : 'Libre pour le reste de la journée';
            }
            return '<div class="sl-card ' + (actuelle ? 'occupee' : '') + '" data-i="' + i + '"' + (actuelle ? ' data-ev="' + s.reservations.indexOf(actuelle) + '"' : '') + '>'
                 + '<h3><span>' + esc(s.nom) + '</span>' + etat + '</h3><div class="sl-meta">' + meta + '</div><div class="sl-now">' + ligne + '</div></div>';
        }).join('') || '<div class="text-muted">Aucune salle trouvée dans Exchange.</div>';
    }

    // ── Planning de la journée ───────────────────────────────────────────
    function dessinerPlanning() {
        let hMin = H_MIN, hMax = H_MAX;
        salles.forEach(s => s.reservations.forEach(r => {
            if (r.journee) return;
            hMin = Math.min(hMin, Math.floor(minutesDans(r.debut, jour) / 60));
            hMax = Math.max(hMax, Math.ceil(minutesDans(r.fin, jour) / 60));
        }));
        const total = (hMax - hMin) * 60;
        const pos = (min) => ((Math.max(hMin * 60, Math.min(hMax * 60, min)) - hMin * 60) / total * 100);

        let heures = '';
        for (let h = hMin; h < hMax; h++) heures += '<div class="sl-hour" style="left:' + pos(h * 60) + '%">' + pad(h) + 'h</div>';
        const lignesHeures = heures.replace(/>\d+h</g, '><');

        let html = '<div class="sl-row head"><div class="sl-name"><b>Salle</b></div><div class="sl-track">' + heures + '</div></div>';
        salles.forEach((s, i) => {
            html += '<div class="sl-row"><div class="sl-name"><b>' + esc(s.nom) + '</b><span>'
                  + [s.capacite ? s.capacite + ' pers.' : '', s.batiment || ''].filter(Boolean).map(esc).join(' · ') + '</span></div>'
                  + '<div class="sl-track" data-i="' + i + '">' + lignesHeures;
            if (s.erreur) {
                html += '<div class="sl-err"><i class="fa-solid fa-triangle-exclamation me-1"></i>' + esc(s.erreur) + '</div>';
            }
            s.reservations.forEach((r, j) => {
                if (r.statut === 'free') return;
                const a = r.journee ? 0 : pos(minutesDans(r.debut, jour));
                const b = r.journee ? 100 : pos(minutesDans(r.fin, jour));
                const moi = r.organisateurEmail && r.organisateurEmail.toLowerCase() === URLS.moi;
                html += '<div class="sl-ev' + (moi ? ' moi' : '') + (r.statut === 'tentative' ? ' tentative' : '') + '" data-i="' + i + '" data-ev="' + j + '"'
                      + ' style="left:' + a + '%;width:calc(' + Math.max(b - a, 0.6) + '% - 2px)"'
                      + ' title="' + esc(hm(r.debut) + '–' + hm(r.fin) + ' ' + r.sujet + (r.organisateur ? ' (' + r.organisateur + ')' : '')) + '">'
                      + '<b>' + (r.prive ? '<i class="fa-solid fa-lock me-1"></i>' : '') + esc(r.sujet) + '</b>'
                      + '<span>' + (r.journee ? 'Toute la journée' : esc(hm(r.debut) + '–' + hm(r.fin))) + (r.organisateur ? ' · ' + esc(r.organisateur) : '') + '</span></div>';
            });
            html += '</div></div>';
        });
        if (!salles.length) html += '<div class="sl-loading">Aucune salle trouvée dans Exchange.</div>';
        $('sl-grid').innerHTML = html;

        // Trait rouge « maintenant »
        if (jour === isoJour(new Date())) {
            const now = new Date(), m = now.getHours() * 60 + now.getMinutes();
            if (m >= hMin * 60 && m <= hMax * 60) {
                const nameW = document.querySelector('#salles-app .sl-name').offsetWidth;
                const trackW = $('sl-grid').offsetWidth - nameW;
                const line = document.createElement('div');
                line.className = 'sl-nowline';
                line.style.left = (nameW + trackW * pos(m) / 100) + 'px';
                $('sl-grid').appendChild(line);
            }
        }
        $('sl-grid').dataset.hmin = hMin;
        $('sl-grid').dataset.hmax = hMax;
    }

    // ── Détail ───────────────────────────────────────────────────────────
    function afficherDetail(s, r) {
        $('sl-detail-title').innerHTML = (r.prive ? '<i class="fa-solid fa-lock me-2"></i>' : '') + esc(r.sujet);
        const date = new Date(r.debut.slice(0, 10) + 'T12:00:00').toLocaleDateString('fr-FR', {weekday: 'long', day: 'numeric', month: 'long'});
        let html = '<dl class="row mb-0">'
            + '<dt class="col-4">Salle</dt><dd class="col-8">' + esc(s.nom) + (s.capacite ? ' <span class="text-muted">(' + s.capacite + ' pers.)</span>' : '') + '</dd>'
            + '<dt class="col-4">Quand</dt><dd class="col-8">' + esc(date) + ', ' + (r.journee ? 'toute la journée' : esc(hm(r.debut) + ' – ' + hm(r.fin)))
            + (r.fin.slice(0, 10) !== r.debut.slice(0, 10) && !r.journee ? ' <span class="text-muted">(jusqu\'au ' + esc(r.fin.slice(8, 10) + '/' + r.fin.slice(5, 7)) + ')</span>' : '') + '</dd>'
            + '<dt class="col-4">Organisateur</dt><dd class="col-8">' + esc(r.organisateur || '—')
            + (r.organisateurEmail ? '<br><a href="mailto:' + esc(r.organisateurEmail) + '" class="small">' + esc(r.organisateurEmail) + '</a>' : '') + '</dd>'
            + '<dt class="col-4">Statut</dt><dd class="col-8">' + ({busy: 'Confirmée', tentative: 'Provisoire', oof: 'Absent', workingElsewhere: 'Ailleurs'}[r.statut] || esc(r.statut))
            + (r.recurrent ? ' · <i class="fa-solid fa-repeat"></i> périodique' : '') + (r.enLigne ? ' · <i class="fa-solid fa-video"></i> réunion Teams' : '') + '</dd>';
        if (r.participants.length) {
            html += '<dt class="col-4">Participants</dt><dd class="col-8"><ul class="list-unstyled mb-0 small">'
                  + r.participants.map(p => '<li>' + esc(p.nom) + ' <span class="text-muted">— ' + esc(REPONSES[p.reponse] || p.reponse) + '</span></li>').join('') + '</ul></dd>';
        }
        html += '</dl>';
        if (r.apercu) html += '<div class="mt-2"><div class="text-muted small mb-1">Description</div><div class="sl-apercu">' + esc(r.apercu) + '</div></div>';
        if (r.prive) html += '<div class="form-text mt-2">Réservation marquée privée dans Outlook : le détail n\'est pas affiché.</div>';
        $('sl-detail-body').innerHTML = html;

        const btn = $('sl-cancel-btn');
        btn.classList.toggle('d-none', !r.annulable);
        btn.onclick = async () => {
            if (!confirm('Annuler cette réservation ? Les participants et la salle seront prévenus.')) return;
            btn.disabled = true;
            try {
                await api(URLS.annuler, {uid: r.uid});
                modalDetail.hide();
                message('Réservation annulée. Le planning de la salle se met à jour d\'ici quelques secondes.', 'ok');
                setTimeout(() => charger(true), 4000);
            } catch (e) {
                alert(e.message);
            } finally {
                btn.disabled = false;
            }
        };
        modalDetail.show();
    }

    // ── Réservation ──────────────────────────────────────────────────────
    function ouvrirReservation(salleEmail, date, debutMin) {
        $('sl-f-salle').innerHTML = salles.filter(s => !s.erreur).map(s =>
            '<option value="' + esc(s.email) + '">' + esc(s.nom) + (s.capacite ? ' (' + s.capacite + ' pers.)' : '') + '</option>').join('');
        if (salleEmail) $('sl-f-salle').value = salleEmail;
        $('sl-f-date').value = date || jour;
        if (debutMin === undefined) {
            const now = new Date();
            debutMin = date && date !== isoJour(now) ? 9 * 60 : Math.ceil((now.getHours() * 60 + now.getMinutes()) / 30) * 30;
        }
        debutMin = Math.min(debutMin, 23 * 60);
        const finMin = Math.min(debutMin + 60, 23 * 60 + 55);
        $('sl-f-debut').value = pad(Math.floor(debutMin / 60)) + ':' + pad(debutMin % 60);
        $('sl-f-fin').value = pad(Math.floor(finMin / 60)) + ':' + pad(finMin % 60);
        $('sl-book-error').classList.add('d-none');
        verifierDispo();
        modalBook.show();
        setTimeout(() => $('sl-f-sujet').focus(), 300);
    }

    // Indication immédiate de conflit (la vérification qui fait foi est faite par le serveur)
    function verifierDispo() {
        const out = $('sl-f-dispo');
        const s = salles.find(x => x.email === $('sl-f-salle').value);
        const d = $('sl-f-date').value, a = $('sl-f-debut').value, b = $('sl-f-fin').value;
        if (!s || !d || !a || !b) { out.innerHTML = ''; return; }
        if (b <= a) { out.innerHTML = '<span class="text-danger">La fin doit être après le début.</span>'; return; }
        if (d !== jour) { out.innerHTML = '<span class="text-muted">La disponibilité sera vérifiée à l\'enregistrement.</span>'; return; }
        const am = parseInt(a.slice(0, 2)) * 60 + parseInt(a.slice(3)), bm = parseInt(b.slice(0, 2)) * 60 + parseInt(b.slice(3));
        const conflit = s.reservations.find(r => r.statut !== 'free' && minutesDans(r.debut, jour) < bm && minutesDans(r.fin, jour) > am);
        out.innerHTML = conflit
            ? '<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Déjà réservée ' + esc(hm(conflit.debut) + '–' + hm(conflit.fin)) + ' (' + esc(conflit.organisateur || conflit.sujet) + ')</span>'
            : '<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Salle libre sur ce créneau</span>';
    }
    ['sl-f-salle', 'sl-f-date', 'sl-f-debut', 'sl-f-fin'].forEach(id => $(id).addEventListener('change', verifierDispo));

    $('sl-book-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = $('sl-book-submit'), err = $('sl-book-error');
        const d = $('sl-f-date').value;
        err.classList.add('d-none');
        btn.disabled = true;
        btn.textContent = 'Réservation…';
        try {
            const res = await api(URLS.reserver, {
                salle: $('sl-f-salle').value,
                debut: d + 'T' + $('sl-f-debut').value,
                fin: d + 'T' + $('sl-f-fin').value,
                sujet: $('sl-f-sujet').value,
                participants: $('sl-f-participants').value,
                description: $('sl-f-description').value,
            });
            modalBook.hide();
            $('sl-book-form').reset();
            message(res.salle + ' réservée. La réunion est dans votre agenda Outlook ; elle apparaît ici dès que la salle l\'a acceptée (quelques secondes).', 'ok');
            if (d !== jour) { jour = d; charger(); }
            setTimeout(() => charger(true), 4000);
            setTimeout(() => charger(true), 15000);
        } catch (ex) {
            err.textContent = ex.message;
            err.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Réserver';
        }
    });

    // ── Événements ───────────────────────────────────────────────────────
    $('sl-grid').addEventListener('click', (e) => {
        const ev = e.target.closest('.sl-ev');
        if (ev) {
            const s = salles[ev.dataset.i];
            return afficherDetail(s, s.reservations[ev.dataset.ev]);
        }
        const track = e.target.closest('.sl-track[data-i]');
        if (!track) return;
        const s = salles[track.dataset.i];
        if (s.erreur) return;
        const hMin = +$('sl-grid').dataset.hmin, hMax = +$('sl-grid').dataset.hmax;
        const rect = track.getBoundingClientRect();
        const min = hMin * 60 + (e.clientX - rect.left) / rect.width * (hMax - hMin) * 60;
        ouvrirReservation(s.email, jour, Math.floor(min / 30) * 30);
    });
    $('sl-cards').addEventListener('click', (e) => {
        const card = e.target.closest('.sl-card[data-i]');
        if (!card) return;
        const s = salles[card.dataset.i];
        if (card.dataset.ev !== undefined) afficherDetail(s, s.reservations[card.dataset.ev]);
        else ouvrirReservation(s.email, jour);
    });

    const allerA = (delta) => {
        const d = new Date(jour + 'T12:00:00');
        d.setDate(d.getDate() + delta);
        jour = isoJour(d);
        charger();
    };
    $('sl-prev').onclick = () => allerA(-1);
    $('sl-next').onclick = () => allerA(1);
    $('sl-today').onclick = () => { jour = isoJour(new Date()); charger(); };
    $('sl-date').onchange = (e) => { if (e.target.value) { jour = e.target.value; charger(); } };
    $('sl-reload').onclick = () => charger();
    $('sl-new').onclick = () => ouvrirReservation(null, jour);
    $('sl-refresh-rooms')?.addEventListener('click', async (e) => {
        e.currentTarget.disabled = true;
        try {
            const r = await api(URLS.rafraichir, {});
            message(r.salles + ' salle(s) trouvée(s) dans Exchange.', 'ok');
            charger(true);
        } catch (ex) {
            message(ex.message, 'err');
        } finally {
            $('sl-refresh-rooms').disabled = false;
        }
    });
    window.addEventListener('resize', () => salles.length && dessinerPlanning());

    // Actualisation automatique toutes les 2 minutes (onglet visible)
    setInterval(() => { if (!document.hidden && !document.querySelector('.modal.show')) charger(true); }, 120000);

    charger();
})();
</script>
{% endblock %}
