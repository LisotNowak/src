{% extends 'tracabilite/layout.html.twig' %}

{% block title %}Nouvelle saisie{% endblock %}

{% block body %}
<div class="p-2 p-md-3 p-lg-4" style="max-width:900px;">

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a href="{{ path('app_tracabilite_saisie_index') }}" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h4 class="mb-0 fw-bold" style="color:#800000;">
            <i class="fas fa-plus-circle me-2"></i>Nouvelle saisie
        </h4>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">
            <i class="fas fa-calendar-alt me-2" style="color:#800000;"></i>Date &amp; Équipe
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    {{ form_label(form.dateTravail) }}
                    {{ form_widget(form.dateTravail) }}
                    {{ form_errors(form.dateTravail) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.chefNom) }}
                    {{ form_widget(form.chefNom) }}
                    {{ form_errors(form.chefNom) }}
                </div>
                <div class="col-md-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label mb-1">Personnel</label>
                        <button type="button" id="btn-toute-equipe" class="btn btn-sm btn-outline-secondary py-0 mb-1" style="font-size:0.75rem;" disabled>
                            <i class="fas fa-users me-1"></i>Toute l'équipe
                        </button>
                    </div>
                    <div id="personnel-chips" class="d-flex flex-wrap gap-2 p-2 border rounded bg-white" style="min-height:76px;">
                        <span class="text-muted small align-self-center">Sélectionnez d'abord une équipe</span>
                    </div>
                    <div id="nbSaisonniersBlock" class="mt-2" style="display:none;">
                        <div class="input-group input-group-sm" style="max-width:240px;">
                            <span class="input-group-text">Nombre de saisonniers</span>
                            <input type="number" name="nbSaisonniers" id="nbSaisonniers" min="1" step="1" value="{{ nbSaisonniers }}" class="form-control">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">
            <i class="fas fa-tools me-2" style="color:#800000;"></i>Tâche &amp; Parcelle
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_label(form.tacheNom) }}
                    {{ form_widget(form.tacheNom) }}
                    {{ form_errors(form.tacheNom) }}
                </div>
                <div class="col-md-6" id="parcelleBlock">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                        {{ form_label(form.parcelleNom) }}
                        <div class="form-check form-switch mb-1 small">
                            <input class="form-check-input" type="checkbox" role="switch" name="multiParcelle" value="1"
                                   id="multiParcelle" {{ multiParcelle ? 'checked' : '' }}>
                            <label class="form-check-label" for="multiParcelle">Plusieurs parcelles</label>
                        </div>
                    </div>
                    <div id="parcelleSimple">
                        {{ form_widget(form.parcelleNom) }}
                        {{ form_errors(form.parcelleNom) }}
                        <div class="form-text" id="parcelle-info"></div>
                        <div class="form-text" id="parcelle-taches"></div>
                    </div>
                    <div id="parcelleMulti" style="display:none;">
                        <input type="search" id="parcelle-search" class="form-control form-control-sm mb-1" placeholder="Filtrer les parcelles…" autocomplete="off">
                        <div id="parcelle-chips" class="d-flex flex-wrap gap-1 p-2 border rounded bg-white" style="max-height:200px; overflow-y:auto;">
                            {% for choice in form.parcelleNom.vars.choices %}
                                <input type="checkbox" class="btn-check" name="parcellesNoms[]" value="{{ choice.value }}"
                                       id="parcheck_{{ loop.index }}" autocomplete="off" {{ choice.value in parcellesNoms ? 'checked' : '' }}>
                                <label class="btn btn-sm btn-outline-success rounded-pill" for="parcheck_{{ loop.index }}">{{ choice.label }}</label>
                            {% endfor %}
                        </div>
                        <div class="form-text" id="parcelles-resume"></div>
                        <div class="form-text text-warning-emphasis">
                            <i class="fas fa-lock me-1"></i>Avancement bloqué à 100 % : une saisie terminée est créée par parcelle, avec les heures ventilées sur chacune.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">
            <i class="fas fa-clock me-2" style="color:#800000;"></i>Heures &amp; Effectif
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    {{ form_label(form.heures) }}
                    {{ form_widget(form.heures) }}
                    {{ form_errors(form.heures) }}
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Effectif</label>
                    <div class="input-group">
                        <input type="text" readonly id="effectif-display"
                               class="form-control bg-light text-center fw-bold"
                               value="0" style="cursor:default;">
                        <span class="input-group-text"><i class="fas fa-users"></i></span>
                    </div>
                    <div class="form-text">Calculé automatiquement</div>
                </div>
            </div>

            {# Ventilation des heures par parcelle (mode multi-parcelles) #}
            <div id="ventilationBlock" class="mt-3" style="display:none;">
                <div class="fw-semibold small mb-1">
                    <i class="fas fa-random me-1" style="color:#800000;"></i>Ventilation des heures par parcelle
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-1">
                        <thead class="table-light">
                            <tr>
                                <th>Parcelle</th>
                                <th class="text-end d-none d-sm-table-cell">Pieds</th>
                                <th style="width:150px;">Heures</th>
                            </tr>
                        </thead>
                        <tbody id="ventilation-lignes"></tbody>
                        <tfoot>
                            <tr>
                                <th>Total</th>
                                <th class="text-end d-none d-sm-table-cell" id="ventilation-pieds"></th>
                                <th id="ventilation-total">0,00h</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="form-text" id="ventilation-vide">Cochez des parcelles pour ventiler les heures.</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">
            <i class="fas fa-seedling me-2" style="color:#800000;"></i>Avancement &amp; Pieds
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    {{ form_label(form.avancement) }}
                    {{ form_errors(form.avancement) }}
                    <div class="d-flex align-items-center gap-2">
                        {{ form_widget(form.avancement, {attr: {type: 'range', class: 'form-range'}}) }}
                        <span id="avancement-display" class="badge text-bg-secondary" style="min-width:48px;">0%</span>
                    </div>
                    <div class="form-text" id="avancement-pieds"></div>
                </div>
                <div class="col-md-4" id="piedsBlock">
                    {{ form_label(form.pieds) }}
                    {{ form_widget(form.pieds) }}
                    {{ form_errors(form.pieds) }}
                </div>
                <div class="col-md-4" id="piedsTotalBlock">
                    {{ form_label(form.piedsTotal) }}
                    {{ form_widget(form.piedsTotal) }}
                    {{ form_errors(form.piedsTotal) }}
                    <div class="form-text" id="pieds-info"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            {{ form_label(form.commentaire) }}
            {{ form_widget(form.commentaire) }}
            {{ form_widget(form.type) }}
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success px-4">
            <i class="fas fa-save me-1"></i>Enregistrer
        </button>
        <a href="{{ path('app_tracabilite_saisie_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </div>

    {{ form_end(form) }}

</div>

<script>
const TACHES    = {{ tachesJson|raw }};
const PARCELLES = {{ parcellesJson|raw }};
const EQUIPES   = {{ equipesJson|raw }};

const selChef           = document.getElementById('saisie_chefNom');
const selTache          = document.getElementById('saisie_tacheNom');
const selParcelle       = document.getElementById('saisie_parcelleNom');
const parcelleBlock     = document.getElementById('parcelleBlock');
const avancementRange   = document.getElementById('saisie_avancement');
const advDisplay        = document.getElementById('avancement-display');
const piedsInput        = document.getElementById('saisie_pieds');
const piedsTotalInput   = document.getElementById('saisie_piedsTotal');
let _sync = false;

// ── Calcul bidirectionnel avancement ↔ pieds ──────────────────────────────

function syncPiedsFromAdv() {
    if (_sync || !piedsInput || !piedsTotalInput) return;
    const total = parseFloat(piedsTotalInput.value) || 0;
    if (total > 0) {
        _sync = true;
        piedsInput.value = Math.round(parseFloat(avancementRange.value) / 100 * total);
        _sync = false;
    }
    updateAdvPieds();
}

function syncAdvFromPieds() {
    if (_sync || !avancementRange || !piedsTotalInput) return;
    const total = parseFloat(piedsTotalInput.value) || 0;
    if (total > 0) {
        _sync = true;
        const adv = Math.min(100, Math.round(parseFloat(piedsInput.value) / total * 100));
        avancementRange.value = adv;
        if (advDisplay) advDisplay.textContent = adv + '%';
        _sync = false;
    }
    updateAdvPieds();
}

// Avancement exprimé en pieds réalisés / pieds total
function updateAdvPieds() {
    const el = document.getElementById('avancement-pieds');
    if (!el || !piedsInput || !piedsTotalInput) return;
    if (isMultiParcelle()) {
        const total = piedsParcellesCochees();
        el.textContent = total > 0 ? total.toLocaleString('fr') + ' / ' + total.toLocaleString('fr') + ' pieds' : '';
        return;
    }
    const total = parseFloat(piedsTotalInput.value) || 0;
    const pieds = parseFloat(piedsInput.value) || 0;
    el.textContent = total > 0
        ? pieds.toLocaleString('fr') + ' / ' + total.toLocaleString('fr') + ' pieds'
        : '';
}

// ── Fonctions de filtrage / mise à jour ───────────────────────────────────

function filterPersonnel(equipeNom, preselected = []) {
    const chips = document.getElementById('personnel-chips');
    const liste = EQUIPES[equipeNom] || [];
    chips.innerHTML = '';
    liste.forEach((o, i) => {
        const id  = 'pcheck_' + i;
        const cb  = document.createElement('input');
        cb.type   = 'checkbox';
        cb.className = 'btn-check';
        cb.name   = 'personnelsNoms[]';
        cb.value  = o.nom;
        cb.id     = id;
        cb.autocomplete = 'off';
        cb.checked = preselected.includes(o.nom);
        cb.addEventListener('change', updateEffectif);

        const lbl = document.createElement('label');
        lbl.className = 'btn btn-sm btn-outline-primary rounded-pill';
        lbl.htmlFor   = id;
        lbl.textContent = o.nom + (o.contrat === 'Permanent' || o.contrat === 'Saisonnier' ? '' : ' (' + o.contrat + ')');

        chips.appendChild(cb);
        chips.appendChild(lbl);
    });
    updateEffectif();
}

const SAISONNIERS = 'Saisonniers non nominatifs';
const nbSaisonniersInput = document.getElementById('nbSaisonniers');

function updateEffectif() {
    const coches = [...document.querySelectorAll('#personnel-chips .btn-check:checked')];
    const avecSaisonniers = coches.some(cb => cb.value === SAISONNIERS);
    document.getElementById('nbSaisonniersBlock').style.display = avecSaisonniers ? '' : 'none';
    let count = coches.filter(cb => cb.value !== SAISONNIERS).length;
    if (avecSaisonniers) count += Math.max(1, parseInt(nbSaisonniersInput.value) || 1);
    document.getElementById('effectif-display').value = count;
    updateBtnTouteEquipe();
}

// Cases des membres nommés de l'équipe (hors saisonniers non nominatifs)
function membresEquipe() {
    return [...document.querySelectorAll('#personnel-chips .btn-check')]
        .filter(cb => cb.value !== SAISONNIERS);
}

function updateBtnTouteEquipe() {
    const btn = document.getElementById('btn-toute-equipe');
    const membres = membresEquipe();
    const tous = membres.length > 0 && membres.every(cb => cb.checked);
    btn.disabled = membres.length === 0;
    btn.innerHTML = tous
        ? '<i class="fas fa-user-minus me-1"></i>Tout retirer'
        : '<i class="fas fa-users me-1"></i>Toute l\'équipe';
}

// Ajoute toutes les personnes de l'équipe (ou les retire si déjà toutes cochées)
document.getElementById('btn-toute-equipe').addEventListener('click', () => {
    const membres = membresEquipe();
    const cocher = !membres.every(cb => cb.checked);
    membres.forEach(cb => { cb.checked = cocher; });
    updateEffectif();
});

function updateParcelleVisibility() {
    const tache = TACHES[selTache.value];
    const sansParcel = tache && tache.sansParcel;
    if (sansParcel) selParcelle.value = '';
    parcelleBlock.style.display = sansParcel ? 'none' : '';
    // En multi-parcelles, les pieds sont ceux de chaque parcelle (pas de saisie manuelle)
    const piedsCaches = sansParcel || multiParcelleInput.checked;
    document.getElementById('piedsBlock').style.display = piedsCaches ? 'none' : '';
    document.getElementById('piedsTotalBlock').style.display = piedsCaches ? 'none' : '';
}

// ── Saisie multi-parcelles (avancement bloqué à 100 %) ─────────────────────

const multiParcelleInput = document.getElementById('multiParcelle');

function isMultiParcelle() {
    return multiParcelleInput.checked && parcelleBlock.style.display !== 'none';
}

function parcellesCochees() {
    return [...document.querySelectorAll('#parcelle-chips .btn-check:checked')].map(cb => cb.value);
}

function piedsParcellesCochees() {
    return parcellesCochees().reduce((s, slug) => s + ((PARCELLES[slug] && PARCELLES[slug].nombrePieds) || 0), 0);
}

function updateParcellesResume() {
    const n = parcellesCochees().length;
    const pieds = piedsParcellesCochees();
    document.getElementById('parcelles-resume').textContent = n
        ? n + ' parcelle(s) sélectionnée(s)' + (pieds ? ' · ' + pieds.toLocaleString('fr') + ' pieds' : '')
        : '';
    renderVentilation();
    updateAdvPieds();
}

// ── Ventilation des heures : une ligne par parcelle cochée ─────────────────

const heuresInput = document.getElementById('saisie_heures');
// Heures déjà saisies par parcelle (conservées si on décoche puis recoche, et après une erreur serveur)
const heuresVentilees = Object.assign({}, {{ heuresParcelles|json_encode|raw }});

function renderVentilation() {
    const tbody = document.getElementById('ventilation-lignes');
    tbody.querySelectorAll('input').forEach(inp => { heuresVentilees[inp.dataset.slug] = inp.value; });
    tbody.innerHTML = '';
    const slugs = parcellesCochees();
    slugs.forEach(slug => {
        const p  = PARCELLES[slug] || {};
        const tr = document.createElement('tr');

        const tdNom = document.createElement('td');
        tdNom.className = 'small fw-semibold';
        tdNom.textContent = slug;

        const tdPieds = document.createElement('td');
        tdPieds.className = 'small text-end text-muted d-none d-sm-table-cell';
        tdPieds.textContent = p.nombrePieds ? p.nombrePieds.toLocaleString('fr') : '—';

        const tdH = document.createElement('td');
        const inp = document.createElement('input');
        inp.type = 'number';
        inp.min  = 0;
        inp.step = 0.25;
        inp.name = 'heuresParcelles[' + slug + ']';
        inp.dataset.slug = slug;
        inp.className = 'form-control form-control-sm ventilation-heures';
        inp.value = heuresVentilees[slug] ?? '';
        inp.addEventListener('input', updateTotalVentile);
        tdH.appendChild(inp);

        tr.append(tdNom, tdPieds, tdH);
        tbody.appendChild(tr);
    });
    document.getElementById('ventilation-vide').style.display = slugs.length ? 'none' : '';
    const pieds = piedsParcellesCochees();
    document.getElementById('ventilation-pieds').textContent = pieds ? pieds.toLocaleString('fr') : '';
    updateTotalVentile();
}

// Le total ventilé alimente le champ « Heures travaillées » (non modifiable en multi-parcelles)
function updateTotalVentile() {
    let total = 0;
    document.querySelectorAll('#ventilation-lignes input').forEach(inp => {
        total += parseFloat(inp.value.replace(',', '.')) || 0;
    });
    total = Math.round(total * 100) / 100;
    document.getElementById('ventilation-total').textContent = total.toFixed(2).replace('.', ',') + 'h';
    if (isMultiParcelle()) heuresInput.value = total;
}

function setMultiParcelle() {
    updateParcelleVisibility();
    const multi = multiParcelleInput.checked;
    document.getElementById('parcelleSimple').style.display = multi ? 'none' : '';
    document.getElementById('parcelleMulti').style.display  = multi ? '' : 'none';

    const bloque = isMultiParcelle();
    if (bloque) {
        avancementRange.value = 100;
        if (advDisplay) advDisplay.textContent = '100%';
    }
    // Le curseur reste soumis (un champ désactivé ne serait pas envoyé) mais n'est plus manipulable
    avancementRange.style.pointerEvents = bloque ? 'none' : '';
    avancementRange.style.opacity       = bloque ? '0.5' : '';
    avancementRange.tabIndex            = bloque ? -1 : 0;

    // Heures : saisies parcelle par parcelle, le champ principal devient le total
    document.getElementById('ventilationBlock').style.display = bloque ? '' : 'none';
    heuresInput.readOnly = bloque;
    heuresInput.classList.toggle('bg-light', bloque);

    if (bloque) updateParcellesResume();
    else syncPiedsFromAdv();
}

document.getElementById('parcelle-search').addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    document.querySelectorAll('#parcelle-chips .btn-check').forEach(cb => {
        const lbl = document.querySelector('label[for="' + cb.id + '"]');
        const visible = !q || lbl.textContent.toLowerCase().includes(q);
        lbl.style.display = visible ? '' : 'none';
    });
});

document.getElementById('parcelle-chips').addEventListener('change', updateParcellesResume);
multiParcelleInput.addEventListener('change', setMultiParcelle);

function updateParcelleInfo() {
    const slug = selParcelle.value;
    const info = document.getElementById('parcelle-info');
    const pInfo = document.getElementById('pieds-info');
    if (slug && PARCELLES[slug]) {
        const p = PARCELLES[slug];
        info.textContent = (p.cepage || '') + (p.nombrePieds ? ' – ' + p.nombrePieds + ' pieds' : '');
        if (p.nombrePieds && piedsTotalInput) {
            piedsTotalInput.value = p.nombrePieds;
            pInfo.textContent = 'Total parcelle : ' + p.nombrePieds + ' pieds';
            syncPiedsFromAdv();
        }
    } else {
        info.textContent = '';
        pInfo.textContent = '';
    }
}

// Tâches déjà en cours sur la parcelle (plusieurs tâches possibles en parallèle)
function updateParcelleTaches() {
    const el = document.getElementById('parcelle-taches');
    const p  = PARCELLES[selParcelle.value];
    const advs = (p && p.avancements) || {};
    const taches = Object.keys(advs).sort((a, b) => a.localeCompare(b, 'fr'));
    el.innerHTML = '';
    if (!taches.length) return;
    el.append('Tâches sur cette parcelle : ');
    taches.forEach((t, i) => {
        const item = document.createElement('span');
        item.textContent = t + ' ' + Math.round(advs[t]) + '%';
        if (t === selTache.value) item.className = 'fw-bold text-dark';
        if (i > 0) el.append(' · ');
        el.appendChild(item);
    });
}

// ── Setup slider avancement ───────────────────────────────────────────────

if (avancementRange) {
    avancementRange.type = 'range';
    avancementRange.min  = 0;
    avancementRange.max  = 100;
    avancementRange.step = 5;
    avancementRange.addEventListener('input', () => {
        if (advDisplay) advDisplay.textContent = avancementRange.value + '%';
        syncPiedsFromAdv();
    });
    if (advDisplay) advDisplay.textContent = (avancementRange.value || '0') + '%';
}

if (piedsInput) {
    piedsInput.addEventListener('input', syncAdvFromPieds);
}

if (piedsTotalInput) {
    piedsTotalInput.addEventListener('input', () => {
        const total = parseFloat(piedsTotalInput.value) || 0;
        if (total > 0) {
            const pieds = parseFloat(piedsInput ? piedsInput.value : 0) || 0;
            if (pieds > 0) syncAdvFromPieds();
            else syncPiedsFromAdv();
        }
    });
}

// ── Événements ────────────────────────────────────────────────────────────

selChef.addEventListener('change', () => filterPersonnel(selChef.value, []));
selTache.addEventListener('change', () => { setMultiParcelle(); updateParcelleTaches(); });
selParcelle.addEventListener('change', () => { updateParcelleInfo(); updateParcelleTaches(); });
nbSaisonniersInput.addEventListener('input', updateEffectif);

// Init
if (selChef.value) filterPersonnel(selChef.value, []);
updateParcelleInfo();
updateParcelleTaches();
setMultiParcelle();
updateAdvPieds();
</script>
{{ include('tracabilite/saisie/_validation.html.twig') }}
{% endblock %}
