{% extends 'tracabilite/layout.html.twig' %}

{% block title %}Tracabilité – Carte{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
{% endblock %}

{% block body %}
<div class="p-2 p-md-3">

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-2 gap-2">
        <div class="d-flex align-items-center gap-2">
            <a href="{{ path('app_tracabilite_carte') }}" class="btn btn-sm btn-outline-secondary" title="Choisir une autre carte">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h4 class="mb-0 fw-bold" style="color:#800000;">
                <i class="fas fa-map-marked-alt me-2"></i>{{ cartePerso ? cartePerso.nom : 'Carte des parcelles' }}
            </h4>
        </div>
        <div class="d-flex flex-wrap gap-1 align-items-center">
            {# ── Filtres période + tâche (le changement de mois recharge la page, la tâche filtre en direct) ── #}
            <form method="get" id="carte-filtres" class="d-flex flex-wrap gap-1 align-items-center me-2">
                <div class="input-group input-group-sm" style="width:auto;">
                    <input type="month" name="mois" value="{{ mois }}" class="form-control form-control-sm" onchange="this.form.submit()" title="Période">
                    <a href="{{ path('app_tracabilite_carte_vue', {mois: '', tache: tache}|merge(cartePerso ? {carte: cartePerso.id} : {})) }}"
                       class="btn {{ mois == '' ? 'btn-secondary' : 'btn-outline-secondary' }}">Tous les mois</a>
                </div>
                <select id="tache-filter" name="tache" class="form-select form-select-sm" style="width:auto; max-width:220px;" title="Filtrer par tâche">
                    <option value="">Toutes les tâches</option>
                    {% for t in taches %}
                        <option value="{{ t }}" {{ tache == t ? 'selected' : '' }}>{{ t }}</option>
                    {% endfor %}
                </select>
                {# La carte choisie sur la page d'accueil est conservée quand on change de mois #}
                {% if cartePerso %}
                <input type="hidden" name="carte" value="{{ cartePerso.id }}">
                {% endif %}
            </form>
            <span class="badge text-bg-light border"><span class="d-inline-block me-1" style="width:10px;height:10px;background:#198754;border-radius:2px;"></span>100%</span>
            <span class="badge text-bg-light border"><span class="d-inline-block me-1" style="width:10px;height:10px;background:#0dcaf0;border-radius:2px;"></span>≥75%</span>
            <span class="badge text-bg-light border"><span class="d-inline-block me-1" style="width:10px;height:10px;background:#ffc107;border-radius:2px;"></span>≥50%</span>
            <span class="badge text-bg-light border"><span class="d-inline-block me-1" style="width:10px;height:10px;background:#dc3545;border-radius:2px;"></span>&lt;50%</span>
        </div>
    </div>

    {% if cartePerso %}
    <div class="alert alert-info py-1 px-2 small mb-2">
        <i class="fas fa-object-group me-1"></i>
        Disposition de la carte personnalisée <strong>{{ cartePerso.nom }}</strong> :
        seules ses {{ cartePerso.disposition|length }} parcelle(s) sont affichées, certaines peuvent être repositionnées
        (distances entre parcelles non réelles, fond de plan désactivé).    </div>
    {% endif %}

    <div class="card border-0 shadow-sm" style="position:relative;" id="map-print-zone">
        <div class="card-body p-0">
            <div id="map" style="height:calc(100vh - 160px); min-height:400px; border-radius:0.375rem;"></div>
        </div>

        {# ── Contrôle fond de carte ── #}
        <div id="basemap-ctrl" style="
            position:absolute; top:10px; right:10px; z-index:1000;
            border-radius:6px; overflow:hidden;
            box-shadow:0 2px 8px rgba(0,0,0,0.3); min-width:110px;
        ">
            <button id="btn-osm"   onclick="setBasemap('osm')"   class="bm-btn active-bm">🗺 Plan</button>
            <button id="btn-sat"   onclick="setBasemap('sat')"   class="bm-btn">🛰 Satellite</button>
            <div style="height:1px; background:#ccc; margin:2px 0;"></div>
            <div style="font-size:0.65rem; color:#888; padding:2px 10px; background:#f8f9fa; text-align:center; letter-spacing:.05em;">IMPRESSION</div>
            <button id="btn-blanc" onclick="setBasemap('blanc')" class="bm-btn">⬜ Blanc</button>
            <div style="height:1px; background:#ccc;"></div>
            <button onclick="printCarte()" class="bm-btn" style="color:#800000; font-weight:700;">🖨 Imprimer</button>
        </div>

        {# ── Bulle d'info parcelle ── #}
        <div id="parcelleInfo" style="
            display:none;
            position:absolute;
            bottom:1.2rem; left:1.2rem;
            z-index:1000;
            min-width:240px; max-width:300px;
            animation: fadeInUp 0.18s ease;
        ">
            <div class="card border-0 shadow-lg" style="border-radius:0.5rem; overflow:hidden;">
                <div class="d-flex justify-content-between align-items-center px-3 py-2"
                     style="background:#800000; color:#fff;">
                    <span class="fw-bold" id="infoSlug" style="font-size:0.95rem;">—</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge fs-6" id="infoAdv">—</span>
                        <button type="button" id="infoClose"
                                style="background:none;border:none;color:rgba(255,255,255,0.8);
                                       font-size:1.3rem;line-height:1;padding:0;cursor:pointer;"
                                title="Fermer">&times;</button>
                    </div>
                </div>
                <div class="card-body py-2 px-3 bg-white small">
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td class="text-muted py-1" style="width:40%;">Cépage</td>
                            <td class="fw-semibold" id="infoCepage">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-1">Gamme</td>
                            <td class="fw-semibold" id="infoGamme">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-1">Pieds</td>
                            <td class="fw-semibold" id="infoPieds">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-1">Surface</td>
                            <td class="fw-semibold"><span id="infoSurface">—</span> ha</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-1 align-top">Tâche(s)</td>
                            <td class="fw-semibold" id="infoTaches">—</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.9.0/proj4.js"></script>
<script>
// ── Projection Lambert 93 ────────────────────────────────────────────────────
proj4.defs('EPSG:2154', '+proj=lcc +lat_0=46.5 +lon_0=3 +lat_1=49 +lat_2=44 +x_0=700000 +y_0=6600000 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=m +no_defs +type=crs');

// ── Carte ────────────────────────────────────────────────────────────────────
const map = L.map('map', { zoomControl: true }).setView([45.20, -0.77], 14);

// Légende d'avancement dans la carte : visible uniquement à l'impression
const Legende = L.Control.extend({
    options: { position: 'bottomleft' },
    onAdd() {
        const el = L.DomUtil.create('div', 'carte-legende-print');
        [['#198754', '100 %'], ['#0dcaf0', '≥ 75 %'], ['#ffc107', '≥ 50 %'], ['#dc3545', '< 50 %']].forEach(([couleur, texte]) => {
            const ligne = L.DomUtil.create('div', 'carte-legende-ligne', el);
            const carre = L.DomUtil.create('span', 'carte-legende-carre', ligne);
            carre.style.background = couleur;
            ligne.append(texte);
        });
        return el;
    },
});
new Legende().addTo(map);

// Cartouche d'impression : nom de la carte + tâche sélectionnée (visible uniquement à l'impression)
const NOM_CARTE = {{ (cartePerso ? cartePerso.nom : 'Carte des parcelles')|json_encode|raw }};
const Cartouche = L.Control.extend({
    options: { position: 'topleft' },
    onAdd() {
        const el = L.DomUtil.create('div', 'carte-cartouche-print');
        L.DomUtil.create('div', 'carte-cartouche-nom', el).textContent = NOM_CARTE;
        L.DomUtil.create('div', 'carte-cartouche-tache', el);
        L.DomUtil.create('div', 'carte-cartouche-date', el);
        return el;
    },
});
new Cartouche().addTo(map);

function majCartouche() {
    const el = document.querySelector('.carte-cartouche-tache');
    if (el) el.textContent = 'Tâche : ' + (currentTache || 'Toutes les tâches');
    // Date du jour au format français (jj/mm/aaaa), recalculée à chaque impression
    const date = document.querySelector('.carte-cartouche-date');
    if (date) date.textContent = 'Le ' + new Date().toLocaleDateString('fr-FR');
}

// Fond de carte plan (OSM)
const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© <a href="https://openstreetmap.org" target="_blank">OpenStreetMap</a>',
    maxZoom: 20
});

// Fond satellite (ESRI World Imagery – gratuit, sans clé API)
const satLayer = L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    attribution: 'Tiles © Esri — Source: Esri, DigitalGlobe, GeoEye, USDA, USGS',
    maxZoom: 20
});


const baseLayers = { osm: osmLayer, sat: satLayer };
osmLayer.addTo(map);
let currentBase = 'osm';

function setBasemap(type) {
    if (type === currentBase) return;
    // Retire le fond actuel
    if (currentBase !== 'blanc' && baseLayers[currentBase]) {
        map.removeLayer(baseLayers[currentBase]);
    }
    // Couleur de fond du div carte
    const mapEl = document.getElementById('map');
    mapEl.style.background = '#ffffff';
    // Ajoute le nouveau fond
    if (type !== 'blanc' && baseLayers[type]) {
        baseLayers[type].addTo(map);
    }
    // Met à jour l'apparence des boutons
    ['osm', 'sat', 'blanc'].forEach(t => {
        const btn = document.getElementById('btn-' + t);
        if (!btn) return;
        if (t === type) { btn.classList.add('active-bm'); }
        else            { btn.classList.remove('active-bm'); }
    });
    currentBase = type;
}

// ── Disposition d'une carte personnalisée ────────────────────────────────────
// { slug: [dx, dy] } en mètres Lambert 93, ou null pour les positions réelles
const DISPOSITION = {{ cartePerso ? cartePerso.disposition|json_encode|raw : 'null' }};
const OPTIONS_PERSO = {{ cartePerso ? cartePerso.options|json_encode|raw : 'null' }};

if (DISPOSITION) {
    // Positions non géographiques : un fond de plan serait trompeur
    setBasemap('blanc');
    ['btn-osm', 'btn-sat'].forEach(id => {
        const b = document.getElementById(id);
        if (b) { b.disabled = true; b.title = 'Indisponible : les parcelles de cette carte personnalisée peuvent être repositionnées'; b.style.opacity = 0.4; }
    });
    // Zoom bloqué : la vue reste cadrée sur les parcelles (le recadrage automatique reste possible)
    map.removeControl(map.zoomControl);
    ['scrollWheelZoom', 'doubleClickZoom', 'touchZoom', 'boxZoom', 'keyboard'].forEach(h => map[h] && map[h].disable());
}

// ── Helpers géométrie ────────────────────────────────────────────────────────
function convertCoords(coords, dx = 0, dy = 0) {
    const [lng, lat] = proj4('EPSG:2154', 'WGS84', [coords[0] + dx, coords[1] + dy]);
    return [lng, lat];
}

// dx, dy : décalage en mètres (Lambert 93) appliqué avant conversion
function convertGeom(geom, dx = 0, dy = 0) {
    const conv = c => convertCoords(c, dx, dy);
    if (geom.type === 'MultiPolygon') {
        return {
            type: 'MultiPolygon',
            coordinates: geom.coordinates.map(poly =>
                poly.map(ring => ring.map(conv))
            )
        };
    }
    if (geom.type === 'Polygon') {
        return {
            type: 'Polygon',
            coordinates: geom.coordinates.map(ring => ring.map(conv))
        };
    }
    return geom;
}

// Crée un layer ou featureGroup selon le type de géométrie.
// Les MultiPolygon sont éclatés en polygones indépendants pour éviter
// l'annulation SVG evenodd sur les zones qui se chevauchent.
function buildLayer(geomWgs, geoJsonOpts) {
    if (geomWgs.type === 'MultiPolygon') {
        const parts = geomWgs.coordinates.map(polyCoords =>
            L.geoJSON({ type: 'Polygon', coordinates: polyCoords }, geoJsonOpts)
        );
        return L.featureGroup(parts);
    }
    return L.geoJSON(geomWgs, geoJsonOpts);
}

function advColor(adv) {
    if (adv <= 0)   return '#adb5bd';
    if (adv >= 100) return '#198754';
    if (adv >= 75)  return '#0dcaf0';
    if (adv >= 50)  return '#ffc107';
    return '#dc3545';
}

// ── Pane de surbrillance au-dessus des polygones ─────────────────────────────
map.createPane('highlight');
map.getPane('highlight').style.zIndex = 450;       // au-dessus des overlays (400)
map.getPane('highlight').style.pointerEvents = 'none'; // ne capte pas les clics

let highlightLayer = null;   // calque de contour séparé
let selectedLayer  = null;   // calque polygon original sélectionné
let selectedProps  = null;   // propriétés de la parcelle sélectionnée
let globalBounds = null;

// ── Filtre par tâche ─────────────────────────────────────────────────────────
let currentTache = {{ tache|json_encode|raw }};   // '' = toutes les tâches
majCartouche();
const parcelLayers = [];     // { layer, p }

// Avancement d'une parcelle selon le filtre de tâche actif
// (toutes tâches : avancement de la tâche la moins avancée)
function advFor(p) {
    if (!currentTache) return p.avancement || 0;
    return (p.avancements && p.avancements[currentTache]) || 0;
}

function nbTaches(p) {
    return Object.keys(p.avancements || {}).length;
}

// Plusieurs tâches menées en parallèle sur la parcelle (visible seulement sans filtre de tâche)
function isMultiTaches(p) {
    return !currentTache && nbTaches(p) > 1;
}

function baseStyle(p) {
    const multi = isMultiTaches(p);
    return {
        color: multi ? '#333' : '#fff',
        weight: multi ? 2.5 : 1.5,
        dashArray: multi ? '6 4' : null,
        fillColor: advColor(advFor(p)),
        fillOpacity: 0.72
    };
}

function tooltipText(p) {
    const n = nbTaches(p);
    return p.slug + (n > 1 ? ' · ' + n + ' tâches' : '');
}

function setAdvBadge(p) {
    const adv   = Math.round(advFor(p));
    const advEl = document.getElementById('infoAdv');
    advEl.textContent = adv + '%';
    advEl.title = isMultiTaches(p) ? 'Tâche la moins avancée (' + nbTaches(p) + ' tâches en cours)' : '';
    advEl.className   = 'badge fs-6 ' + (
        adv >= 100 ? 'text-bg-success' :
        adv >= 75  ? 'text-bg-info'    :
        adv >= 50  ? 'text-bg-warning' :
        adv >  0   ? 'text-bg-danger'  : 'text-bg-secondary'
    );
}

function setTacheFilter(tache) {
    currentTache = tache;
    majCartouche();
    parcelLayers.forEach(({ layer, p }) => layer.setStyle(baseStyle(p)));
    ordonnerCalques();
    if (selectedProps) {
        setAdvBadge(selectedProps);
        setTachesInfo(selectedProps);
    }
}

// Ordre de dessin : sans saisie, puis avec avancement, puis plusieurs tâches.
// Une parcelle voisine dessinée après recouvrirait sinon la limite commune (et la bordure en pointillés).
function ordonnerCalques() {
    const rang = p => isMultiTaches(p) ? 2 : (advFor(p) > 0 ? 1 : 0);
    parcelLayers
        .slice()
        .sort((a, b) => rang(a.p) - rang(b.p))
        .forEach(({ layer }) => layer.bringToFront());
}

// Tâches de la parcelle (en parallèle) avec leur avancement, ou la seule tâche filtrée
function setTachesInfo(p) {
    const el = document.getElementById('infoTaches');
    const advs = p.avancements || {};
    // Les moins avancées d'abord : ce qui reste à faire en tête
    const taches = currentTache
        ? [currentTache]
        : Object.keys(advs).sort((a, b) => (advs[a] - advs[b]) || a.localeCompare(b, 'fr'));
    el.innerHTML = '';
    if (!taches.length) { el.textContent = '—'; return; }
    taches.forEach(t => {
        const adv = advs[t] || 0;
        const ligne = document.createElement('div');
        ligne.className = 'mb-1';

        const titre = document.createElement('div');
        titre.className = 'd-flex justify-content-between gap-2';
        const nom = document.createElement('span');
        nom.textContent = t;
        const pct = document.createElement('span');
        pct.className = 'text-nowrap';
        pct.textContent = Math.round(adv) + '%';
        titre.append(nom, pct);
        ligne.appendChild(titre);

        const barre = document.createElement('div');
        barre.className = 'progress';
        barre.style.height = '4px';
        const rempli = document.createElement('div');
        rempli.className = 'progress-bar';
        rempli.style.width = Math.min(100, adv) + '%';
        rempli.style.background = advColor(adv);
        barre.appendChild(rempli);
        ligne.appendChild(barre);

        if (p.nombrePieds) {
            const realises = Math.round(adv / 100 * p.nombrePieds);
            const pieds = document.createElement('div');
            pieds.className = 'text-muted fw-normal';
            pieds.style.fontSize = '0.7rem';
            pieds.textContent = realises.toLocaleString('fr') + ' / ' + p.nombrePieds.toLocaleString('fr') + ' pieds';
            ligne.appendChild(pieds);
        }
        el.appendChild(ligne);
    });
}

document.getElementById('tache-filter')
    ?.addEventListener('change', e => {
        setTacheFilter(e.target.value);
        // Garde la tâche dans l'URL pour qu'un rechargement la conserve
        const url = new URL(window.location.href);
        url.searchParams.set('mois', {{ mois|json_encode|raw }});
        url.searchParams.set('tache', e.target.value);
        history.replaceState(null, '', url);
    });

fetch('{{ path("app_tracabilite_carte_geojson", {mois: mois}) }}')
    .then(r => r.json())
    .then(data => {
        data.features.forEach(f => {
            try {
                const p = f.properties;
                // Carte personnalisée : uniquement ses parcelles, à leur position modifiée
                if (DISPOSITION && !DISPOSITION[p.slug]) return;
                const [dx, dy]       = DISPOSITION ? DISPOSITION[p.slug] : [0, 0];
                const geomWgs        = convertGeom(f.geometry, dx, dy);

                const layer = buildLayer(geomWgs, { style: baseStyle(p) }).addTo(map);
                parcelLayers.push({ layer, p });

                // Noms permanents, comme sur la carte personnalisée
                if (OPTIONS_PERSO && OPTIONS_PERSO.afficherNoms !== false) {
                    const span = document.createElement('span');
                    span.textContent = p.slug;
                    L.marker(layer.getBounds().getCenter(), {
                        icon: L.divIcon({ className: 'cp-label', html: span.outerHTML, iconSize: null }),
                        interactive: false, keyboard: false,
                    }).addTo(map);
                }

                // Tooltip au survol
                layer.bindTooltip(() => tooltipText(p), {
                    permanent: false,
                    direction: 'center',
                    className: 'leaflet-tooltip-parcel'
                });

                // Clic → bulle d'info + contour de surbrillance
                layer.on('click', () => {
                    // Supprime l'ancien contour de surbrillance
                    if (highlightLayer) { map.removeLayer(highlightLayer); highlightLayer = null; }
                    // Remet le style d'origine sur l'ancien polygone sélectionné
                    if (selectedLayer && selectedLayer !== layer) {
                        selectedLayer.setStyle(baseStyle(selectedProps));
                    }
                    selectedLayer = layer;
                    selectedProps = p;

                    // Calque de contour noir épais dans le pane highlight (par-dessus tout)
                    highlightLayer = buildLayer(geomWgs, {
                        pane: 'highlight',
                        style: { color: '#000', weight: 4, opacity: 1, fill: false }
                    }).addTo(map);

                    // Remplit la bulle
                    document.getElementById('infoSlug').textContent   = p.slug;
                    document.getElementById('infoCepage').textContent  = p.cepage    || '—';
                    document.getElementById('infoGamme').textContent   = p.gamme     || '—';
                    document.getElementById('infoPieds').textContent   = p.nombrePieds ? p.nombrePieds.toLocaleString('fr') : '—';
                    document.getElementById('infoSurface').textContent = p.surface   || '—';

                    setAdvBadge(p);
                    setTachesInfo(p);

                    // Anime la bulle
                    const panel = document.getElementById('parcelleInfo');
                    panel.style.display = 'none';
                    requestAnimationFrame(() => { panel.style.display = 'block'; });
                });

                // Accumule les bounds globales
                try {
                    const lb = layer.getBounds();
                    globalBounds = globalBounds ? globalBounds.extend(lb) : lb;
                } catch(e) {}

            } catch(e) {
                console.warn('Parcelle ignorée :', f.properties?.slug, e.message);
            }
        });

        ordonnerCalques();

        // Zoom initial sur toutes les parcelles
        if (globalBounds) {
            map.fitBounds(globalBounds, { padding: [20, 20] });
        }
    })
    .catch(e => console.error('Erreur chargement GeoJSON', e));

// ── Impression ───────────────────────────────────────────────────────────────
// La zone prend la taille exacte de la feuille (A4 paysage, sans marge) puis la vue est
// recadrée au centre sur les parcelles affichées : l'impression reproduit ce cadrage.
const printZone = document.getElementById('map-print-zone');
let vueAvantImpression = null;

function preparerImpression() {
    if (document.body.classList.contains('carte-printing')) return;
    vueAvantImpression = { centre: map.getCenter(), zoom: map.getZoom() };
    majCartouche();
    document.body.classList.add('carte-printing');
    map.invalidateSize(false);
    if (globalBounds) map.fitBounds(globalBounds, { padding: [25, 25], animate: false });
}

function finImpression() {
    if (!document.body.classList.contains('carte-printing')) return;
    document.body.classList.remove('carte-printing');
    map.invalidateSize(false);
    if (vueAvantImpression) map.setView(vueAvantImpression.centre, vueAvantImpression.zoom, { animate: false });
}

function printCarte() {
    preparerImpression();
    setTimeout(() => window.print(), 400);   // laisse le temps aux tuiles du fond de se charger
}
window.addEventListener('beforeprint', preparerImpression);
window.addEventListener('afterprint', finImpression);

// ── Fermer la bulle ──────────────────────────────────────────────────────────
document.getElementById('infoClose').addEventListener('click', () => {
    document.getElementById('parcelleInfo').style.display = 'none';
    if (highlightLayer) { map.removeLayer(highlightLayer); highlightLayer = null; }
    if (selectedLayer) {
        selectedLayer.setStyle(baseStyle(selectedProps));
        selectedLayer = null;
    }
    selectedProps = null;
});
</script>

<style>
/* Boutons fond de carte */
.bm-btn {
    display: block;
    width: 100%;
    padding: 5px 12px;
    border: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    background: #fff;
    color: #333;
    text-align: left;
    transition: background 0.12s;
}
.bm-btn:hover  { background: #f0f0f0; }
.bm-btn.active-bm { background: #800000 !important; color: #fff !important; }
/* ── Impression paysage – carte seule ─────────────────────────────────────── */
@page {
    size: A4 landscape;
    margin: 0;
}
@media print {
    /* Masque tout le reste de la page */
    body > *           { visibility: hidden !important; }
    body               { overflow: visible !important; background: #fff !important; }

    /* Seule la zone carte est visible, plein écran */
    #map-print-zone,
    #map-print-zone *  { visibility: visible !important; }

    #map-print-zone {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        border: none !important;
    }
    #map {
        width: 100% !important;
        height: 100% !important;
        min-height: unset !important;
        border-radius: 0 !important;
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
    }
    /* Masque les contrôles à l'intérieur de la zone carte.
       display (et non visibility) : la règle « #map-print-zone * » rendrait leurs boutons visibles */
    #basemap-ctrl,
    #parcelleInfo,
    .leaflet-control-zoom,
    .leaflet-control-attribution { display: none !important; }
}

/* Légende d'avancement : masquée à l'écran (déjà dans l'en-tête), affichée à l'impression */
.carte-legende-print {
    display: none;
    background: #fff; border: 1px solid #999; border-radius: 4px;
    padding: 4px 8px; font-size: 11px; line-height: 1.5; color: #222;
    print-color-adjust: exact; -webkit-print-color-adjust: exact;
}
.carte-legende-ligne { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
.carte-legende-carre {
    display: inline-block; width: 12px; height: 12px; border-radius: 2px; border: 1px solid rgba(0,0,0,.25);
    print-color-adjust: exact; -webkit-print-color-adjust: exact;
}
body.carte-printing .carte-legende-print { display: block; }

/* Cartouche (nom de la carte + tâche) : même règle d'affichage que la légende */
.carte-cartouche-print {
    display: none;
    background: #fff; border: 1px solid #999; border-radius: 4px;
    padding: 4px 10px; color: #222; line-height: 1.35;
}
.carte-cartouche-nom   { font-weight: 700; font-size: 14px; color: #800000; }
.carte-cartouche-tache { font-size: 12px; }
.carte-cartouche-date  { font-size: 11px; color: #555; }
body.carte-printing .carte-cartouche-print { display: block; }
@media print {
    .carte-legende-print,
    .carte-cartouche-print { display: block !important; }
}

/* Préparation à l'impression, à l'écran : même taille que la feuille A4 paysage */
body.carte-printing #map-print-zone {
    position: fixed !important;
    left: 0; top: 0;
    width: 297mm !important;
    height: 210mm !important;
    z-index: 2000;
    background: #fff;
}
body.carte-printing #map {
    width: 100% !important;
    height: 100% !important;
    min-height: unset !important;
}

/* Noms des parcelles (disposition d'une carte personnalisée) */
#map { --cp-police: {{ cartePerso ? (cartePerso.options.taillePolice ?? 11) : 11 }}px; }
.cp-label { background: none; border: none; }
.cp-label span {
    position: absolute; transform: translate(-50%, -50%);
    white-space: nowrap; font-size: var(--cp-police); font-weight: 600; color: #222;
    text-shadow: 0 0 3px #fff, 0 0 3px #fff, 0 0 2px #fff;
    pointer-events: none;
}

.leaflet-tooltip-parcel {
    font-size: 0.72rem;
    padding: 2px 6px;
    background: rgba(0,0,0,0.65);
    color: #fff;
    border: none;
    border-radius: 3px;
}
.leaflet-tooltip-parcel::before { display: none; }

/* Supprime le rectangle de focus navigateur sur les polygones SVG Leaflet */
.leaflet-interactive:focus {
    outline: none !important;
}

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}
</style>
{% endblock %}
