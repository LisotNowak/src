{# Affiche un SVG de PortalIconChoices teinté via un masque CSS (un <img> ne peut pas hériter de la couleur).
   Attend `src` (chemin public), `size` (ex: 2em), `color` et, en option, `class`. #}
<span class="d-inline-block flex-shrink-0 {{ class|default('') }}" aria-hidden="true" style="width:{{ size }};height:{{ size }};background-color:{{ color }};-webkit-mask:url('{{ asset(src) }}') center/contain no-repeat;mask:url('{{ asset(src) }}') center/contain no-repeat;"></span>
