{# Attend une variable `field` = la FormView du champ image (ChoiceType) #}
{% set field_id = field.vars.id %}
{{ form_label(field) }}
<div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 w-100"
            type="button" id="{{ field_id }}_toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <span id="{{ field_id }}_preview" class="d-inline-block flex-shrink-0" style="width:16px;height:16px;background-color:currentColor;"></span>
        <span id="{{ field_id }}_label" class="flex-grow-1 text-start"></span>
    </button>
    <ul class="dropdown-menu w-100" id="{{ field_id }}_menu" aria-labelledby="{{ field_id }}_toggle" style="max-height:320px;overflow-y:auto;">
        {% if field.vars.placeholder is not none %}
            <li>
                <button type="button" class="dropdown-item d-flex align-items-center gap-2 icone-option" data-value="" data-url="" data-label="{{ field.vars.placeholder }}">
                    <span class="d-inline-block flex-shrink-0" style="width:16px;height:16px;"></span>
                    {{ field.vars.placeholder }}
                </button>
            </li>
        {% endif %}
        {% for choice in field.vars.choices %}
            <li>
                <button type="button" class="dropdown-item d-flex align-items-center gap-2 icone-option" data-value="{{ choice.value }}" data-url="{{ asset(choice.value) }}" data-label="{{ choice.label }}">
                    {% include 'admin/portail/_icone_svg.html.twig' with {src: choice.value, size: '16px', color: '#495057'} only %}
                    {{ choice.label }}
                </button>
            </li>
        {% endfor %}
    </ul>
    <div class="d-none">{{ form_widget(field) }}</div>
</div>
{{ form_errors(field) }}

<script>
(function () {
    var select = document.getElementById('{{ field_id }}');
    var preview = document.getElementById('{{ field_id }}_preview');
    var label = document.getElementById('{{ field_id }}_label');
    var menu = document.getElementById('{{ field_id }}_menu');

    function applyOption(btn) {
        var mask = btn.dataset.url ? 'url("' + btn.dataset.url + '") center/contain no-repeat' : '';
        select.value = btn.dataset.value;
        preview.style.visibility = btn.dataset.url ? 'visible' : 'hidden';
        preview.style.webkitMask = mask;
        preview.style.mask = mask;
        label.textContent = btn.dataset.label;
    }

    menu.querySelectorAll('.icone-option').forEach(function (btn) {
        if (btn.dataset.value === select.value) {
            applyOption(btn);
        }
        btn.addEventListener('click', function () {
            applyOption(this);
            select.dispatchEvent(new Event('change'));
        });
    });
})();
</script>
