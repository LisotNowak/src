      const portLink = x => x.switch ? `<a href="#" data-sw="${esc(x.switch)}" data-p="${esc(x.port)}" style="color:var(--accent)">${esc(x.switch_name)} · ${esc(x.port)}</a>` : `<span class="muted">—</span>`;
      const clusters = S.wifi||[];
