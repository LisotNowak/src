{% extends 'aruba/layout.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}Valeurs par défaut et options{% endblock %}
{% block body %}
<div class="container mt-4 mb-5" style="max-width:960px">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_gestion_switch_index') }}">Gestion switch</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_gestion_switch_admin_index') }}">Configuration</a></li>
            <li class="breadcrumb-item active">Valeurs par défaut et options</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h1 class="h4 mb-0"><i class="fas fa-gear me-2" style="color:#800000"></i>Valeurs par défaut et options</h1>
        </div>
        <div class="card-body">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <h2 class="h6 text-muted text-uppercase mb-3">Identifiants par défaut</h2>
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.username) }}</div>
                    <div class="col-md-6">{{ form_row(form.password) }}</div>
                </div>

                <h2 class="h6 text-muted text-uppercase mt-4 mb-3">Interrogation</h2>
                <div class="row g-3">
                    <div class="col-md-4">{{ form_row(form.timeout) }}</div>
                    <div class="col-md-4">{{ form_row(form.api_version) }}</div>
                    <div class="col-md-4">{{ form_row(form.parallel) }}</div>
                    <div class="col-12">{{ form_row(form.verify_ssl) }}</div>
                </div>

                <h2 class="h6 text-muted text-uppercase mt-4 mb-3">Switchs sans API</h2>
                {{ form_row(form.other_switches) }}

                <hr class="my-4">
                <button class="btn btn-success"><i class="fas fa-check me-1"></i>Enregistrer</button>
                <a href="{{ path('app_gestion_switch_admin_index') }}" class="btn btn-outline-secondary">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
