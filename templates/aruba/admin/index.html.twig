{% extends 'aruba/layout.html.twig' %}
{% block title %}Configuration{% endblock %}
{% block body %}
<div class="container-fluid mt-4 mb-5 px-4" style="max-width:1400px">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-sliders me-2" style="color:#800000"></i>Configuration</h1>
            <span class="text-muted small">Switchs et bornes Wi-Fi interrogés. Les modifications sont prises en compte à la prochaine actualisation.</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('app_gestion_switch_admin_new') }}" class="btn btn-success">
                <i class="fas fa-plus me-1"></i>Ajouter un switch
            </a>
            <a href="{{ path('app_gestion_switch_admin_new', {type: 'wifi'}) }}" class="btn btn-outline-success">
                <i class="fas fa-wifi me-1"></i>Ajouter un cluster Wi-Fi
            </a>
        </div>
    </div>

    {% for type in ['success', 'danger'] %}
        {% for message in app.flashes(type) %}
            <div class="alert alert-{{ type }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% if running %}
        <div class="alert alert-info"><i class="fas fa-spinner fa-spin me-2"></i>Une collecte est en cours : les modifications s'appliqueront à la suivante.</div>
    {% endif %}

    {# ── Paramètres communs ── #}
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-4">
            <div><span class="text-muted small d-block">Utilisateur par défaut</span><b>{{ defaults.username ?? '—' }}</b>
                {% if not common_password %}<span class="badge bg-danger ms-1">mot de passe manquant</span>{% endif %}
            </div>
            <div><span class="text-muted small d-block">Délai de réponse</span>{{ defaults.timeout ?? 15 }} s</div>
            <div><span class="text-muted small d-block">Interrogés en même temps</span>{{ parallel }} équipements</div>
            <div>
                <span class="text-muted small d-block">Switchs sans API</span>
                {% for o in other_switches %}
                    <span class="badge bg-light text-dark border fw-normal">{{ o.name ?? o.host }}{% if o.name is defined and o.host is defined %} <span class="text-muted font-monospace">{{ o.host }}</span>{% endif %}</span>
                {% else %}
                    <span class="text-muted">aucun</span>
                {% endfor %}
            </div>
            <a href="{{ path('app_gestion_switch_admin_settings') }}" class="btn btn-outline-secondary ms-auto">
                <i class="fas fa-gear me-1"></i>Valeurs par défaut et options
            </a>
        </div>
    </div>

    {# ── Switchs ── #}
    <h2 class="h5 mb-2"><i class="fas fa-network-wired me-2" style="color:#800000"></i>Switchs <span class="badge bg-secondary">{{ switches|length }}</span></h2>
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px"></th>
                        <th>Switch</th>
                        <th>Adresse</th>
                        <th>Système</th>
                        <th>Identifiants</th>
                        <th>Dernière collecte</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sw in switches %}
                        <tr id="sw-{{ sw.id }}">
                            <td class="text-nowrap">
                                {% for sens in ['haut', 'bas'] %}
                                    <form method="post" action="{{ path('app_gestion_switch_admin_move', {id: sw.id, sens: sens}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('move' ~ sw.id) }}">
                                        <button class="btn btn-link btn-sm p-0 px-1 text-secondary" title="Monter / descendre"
                                            {% if (sens == 'haut' and loop.parent.loop.first) or (sens == 'bas' and loop.parent.loop.last) %}disabled{% endif %}>
                                            <i class="fas fa-arrow-{{ sens == 'haut' ? 'up' : 'down' }}"></i>
                                        </button>
                                    </form>
                                {% endfor %}
                            </td>
                            <td>
                                <div class="fw-semibold">{{ sw.name ?: sw.id }}</div>
                                <div class="small text-muted"><code>{{ sw.id }}</code>{% if sw.site is defined and sw.site %} · {{ sw.site }}{% endif %}</div>
                            </td>
                            <td class="font-monospace small">{{ sw.host }}</td>
                            <td>
                                {% if (sw.os ?? 'aos-cx') == 'aos-switch' %}
                                    <span class="badge bg-secondary">ArubaOS-Switch</span>
                                    {% if (sw.protocol ?? 'https') == 'http' %}
                                        <span class="badge bg-light text-dark border">HTTP</span>
                                    {% else %}
                                        <span class="badge bg-light text-dark border">HTTPS</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge" style="background:#800000">AOS-CX</span>
                                    <span class="badge bg-light text-dark border">HTTPS</span>
                                {% endif %}
                                {% if sw.last and sw.last.platform %}
                                    <div class="small text-muted mt-1">{{ sw.last.platform }}</div>
                                {% endif %}
                            </td>
                            <td class="small">
                                {% set own_user = sw.own.username ?? '' %}
                                <i class="fas fa-user me-1 text-muted"></i>{{ own_user ?: defaults.username ?? '' }}
                            </td>
                            <td class="small">
                                {% if not sw.last %}
                                    <span class="text-muted">jamais interrogé</span>
                                {% elseif sw.last.error %}
                                    <span class="text-danger"><i class="fas fa-xmark me-1"></i>erreur</span>
                                    <div class="text-muted" style="max-width:320px">{{ sw.last.error }}</div>
                                {% else %}
                                    <span class="text-success"><i class="fas fa-check me-1"></i>OK</span>
                                    {% if sw.last.collected_at %}<span class="text-muted">· {{ sw.last.collected_at|date('d/m/Y H:i', 'Europe/Paris') }}</span>{% endif %}
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">
                                <form method="post" action="{{ path('app_gestion_switch_admin_test', {id: sw.id}) }}" class="d-inline js-test">
                                    <input type="hidden" name="_token" value="{{ csrf_token('test' ~ sw.id) }}">
                                    <button class="btn btn-outline-secondary btn-sm" title="Tester la connexion"><i class="fas fa-plug"></i></button>
                                </form>
                                <a href="{{ path('app_gestion_switch_admin_edit', {id: sw.id}) }}" class="btn btn-primary btn-sm" title="Modifier">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <form method="post" action="{{ path('app_gestion_switch_admin_delete', {id: sw.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Supprimer le switch « {{ (sw.name ?: sw.id)|e('js') }} » et son mot de passe ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sw.id) }}">
                                    <button class="btn btn-danger btn-sm" title="Supprimer"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fas fa-network-wired fa-2x mb-2 d-block"></i>
                                Aucun switch configuré
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ── Bornes Wi-Fi : un cluster Aruba Instant par contrôleur virtuel, bornes découvertes automatiquement ── #}
    <h2 class="h5 mb-2"><i class="fas fa-wifi me-2" style="color:#8b5cf6"></i>Clusters Wi-Fi <span class="badge bg-secondary">{{ clusters|length }}</span></h2>
    {% for cl in clusters %}
        {% set aps = cl.last.aps ?? [] %}
        <div class="card shadow-sm mb-3" id="sw-{{ cl.id }}">
            <div class="card-body d-flex flex-wrap align-items-center gap-4">
                <div>
                    <div class="fw-semibold">{{ cl.name ?: cl.id }}</div>
                    <div class="small text-muted"><code>{{ cl.id }}</code>{% if cl.site is defined and cl.site %} · {{ cl.site }}{% endif %}</div>
                </div>
                <div><span class="text-muted small d-block">Contrôleur virtuel</span><span class="font-monospace small">{{ cl.host }}</span></div>
                <div class="small"><span class="text-muted small d-block">Utilisateur</span>
                    <i class="fas fa-user me-1 text-muted"></i>{{ (cl.own.username ?? '') ?: defaults.username ?? '' }}</div>
                <div class="small"><span class="text-muted small d-block">Dernière collecte</span>
                    {% if not cl.last %}
                        <span class="text-muted">jamais interrogé</span>
                    {% elseif cl.last.error %}
                        <span class="text-danger"><i class="fas fa-xmark me-1"></i>erreur</span>
                        <div class="text-muted" style="max-width:420px">{{ cl.last.error }}</div>
                    {% else %}
                        <span class="text-success"><i class="fas fa-check me-1"></i>OK</span>
                        <span class="text-muted">· {{ cl.last.platform }}{% if cl.last.collected_at %} · {{ cl.last.collected_at|date('d/m/Y H:i', 'Europe/Paris') }}{% endif %}</span>
                    {% endif %}
                </div>
                <div class="ms-auto text-nowrap">
                    <form method="post" action="{{ path('app_gestion_switch_admin_test', {id: cl.id}) }}" class="d-inline js-test">
                        <input type="hidden" name="_token" value="{{ csrf_token('test' ~ cl.id) }}">
                        <button class="btn btn-outline-secondary btn-sm" title="Tester la connexion"><i class="fas fa-plug"></i></button>
                    </form>
                    <a href="{{ path('app_gestion_switch_admin_edit', {id: cl.id}) }}" class="btn btn-primary btn-sm" title="Modifier"><i class="fas fa-pen"></i></a>
                    <form method="post" action="{{ path('app_gestion_switch_admin_delete', {id: cl.id}) }}" class="d-inline"
                          onsubmit="return confirm('Supprimer le cluster « {{ (cl.name ?: cl.id)|e('js') }} » et son mot de passe ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cl.id) }}">
                        <button class="btn btn-danger btn-sm" title="Supprimer"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            {% if aps %}
                <div class="table-responsive border-top">
                    <table class="table table-sm table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr><th class="ps-3">Borne</th><th>IP</th><th>Modèle</th><th>N° de série</th><th>Clients</th><th>Branchée sur</th></tr>
                        </thead>
                        <tbody>
                            {% for ap in aps %}
                                <tr>
                                    <td class="ps-3 fw-semibold">{{ ap.name }}{% if ap.conductor %} <span class="badge bg-light text-dark border">maître</span>{% endif %}</td>
                                    <td class="font-monospace">{{ ap.ip }}</td>
                                    <td>{{ ap.model }}</td>
                                    <td class="font-monospace text-muted">{{ ap.serial }}</td>
                                    <td>{{ ap.clients }}</td>
                                    <td>{% if ap.switch %}{{ ap.switch_name }} · {{ ap.port }}{% else %}<span class="text-muted">—</span>{% endif %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-4">
                <i class="fas fa-wifi fa-2x mb-2 d-block"></i>
                Aucun cluster Wi-Fi configuré
            </div>
        </div>
    {% endfor %}

    {# ── GLPI : fiches du parc retrouvées par adresse MAC ── #}
    <h2 class="h5 mb-2 mt-4" id="glpi"><i class="fas fa-box-archive me-2" style="color:#800000"></i>GLPI</h2>
    <div class="card shadow-sm mb-3">
        {% if glpi %}
            <div class="card-body d-flex flex-wrap align-items-center gap-4">
                <div>
                    <div class="fw-semibold"><a href="{{ glpi.url }}" target="_blank" rel="noopener" class="text-decoration-none" style="color:#800000">{{ glpi.url|replace({'https://': '', 'http://': ''}) }}</a></div>
                    <div class="small text-muted">{{ (glpi.enabled ?? true) ? 'Interrogé à chaque actualisation' : 'Désactivé' }}</div>
                </div>
                <div class="small"><span class="text-muted small d-block">Compte</span>
                    <i class="fas fa-user me-1 text-muted"></i>{{ glpi.username ?? '' }}</div>
                <div class="small"><span class="text-muted small d-block">Dernière collecte</span>
                    {% if not glpi_last %}
                        <span class="text-muted">jamais interrogé</span>
                    {% elseif glpi_last.error %}
                        <span class="text-danger"><i class="fas fa-xmark me-1"></i>erreur</span>
                        <div class="text-muted" style="max-width:420px">{{ glpi_last.error }}</div>
                    {% else %}
                        <span class="text-success"><i class="fas fa-check me-1"></i>OK</span>
                        <span class="text-muted">· {{ glpi_last.assets }} éléments du parc · {{ glpi_last.matched }} appareils retrouvés sur le réseau{% if glpi_last.collected_at %} · {{ glpi_last.collected_at|date('d/m/Y H:i', 'Europe/Paris') }}{% endif %}</span>
                    {% endif %}
                </div>
                <div class="ms-auto text-nowrap">
                    <form method="post" action="{{ path('app_gestion_switch_admin_glpi_test') }}" class="d-inline js-test">
                        <input type="hidden" name="_token" value="{{ csrf_token('test-glpi') }}">
                        <button class="btn btn-outline-secondary btn-sm" title="Tester la connexion"><i class="fas fa-plug"></i></button>
                    </form>
                    <a href="{{ path('app_gestion_switch_admin_glpi') }}" class="btn btn-primary btn-sm" title="Modifier"><i class="fas fa-pen"></i></a>
                    <form method="post" action="{{ path('app_gestion_switch_admin_glpi_delete') }}" class="d-inline"
                          onsubmit="return confirm('Retirer GLPI et ses identifiants ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-glpi') }}">
                        <button class="btn btn-danger btn-sm" title="Supprimer"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
        {% else %}
            <div class="card-body text-center text-muted py-4">
                <i class="fas fa-box-archive fa-2x mb-2 d-block"></i>
                GLPI n'est pas configuré<br>
                <a href="{{ path('app_gestion_switch_admin_glpi') }}" class="btn btn-outline-primary btn-sm mt-2"><i class="fas fa-plus me-1"></i>Configurer GLPI</a>
            </div>
        {% endif %}
    </div>
</div>

<script>
    // le test de connexion prend jusqu'à 15 s si le switch ne répond pas : on le signale sur le bouton
    document.querySelectorAll('form.js-test').forEach(f => f.addEventListener('submit', () => {
        const b = f.querySelector('button');
        b.disabled = true;
        b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Test…';
    }));
</script>
{% endblock %}
